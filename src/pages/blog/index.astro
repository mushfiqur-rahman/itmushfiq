---
import ListingLayout from '../../layouts/ListingLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts } from '../../utils/posts';
const posts = await getPosts('blog');
---
<ListingLayout
  title="Email Migration & Deliverability Guides | IT Support Bee"
  description="Field-tested guides on Microsoft 365 and Google Workspace migrations, SPF, DKIM and DMARC, and the email systems that keep your team working."
  eyebrow="Insights & guides"
  heading="Practical IT guidance."
  accent="Without the jargon."
>
  <div class="mb-6 flex items-center justify-between gap-4">
    <h2 class="text-xl font-semibold text-white">Latest articles</h2>
    <span class="text-sm text-slate-400">{posts.length} articles</span>
  </div>
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {posts.map((post, index) => <ArticleCard post={post} eager={index < 3} />)}
  </div>
</ListingLayout>
