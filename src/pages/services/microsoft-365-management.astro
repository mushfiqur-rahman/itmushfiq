---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const title = "Microsoft 365, Intune & Entra ID Management | IT Support Bee";
const description =
  "Secure your remote workforce with enterprise-grade Microsoft 365 administration, Intune device management, and Entra ID identity protection.";
const currentUrl = Astro.url.href;

const faqs = [
  {
    question: "Do we need to buy new laptops for Microsoft Intune to work?",
    answer:
      "No. While Intune works flawlessly with new devices via Windows Autopilot (zero-touch setup), we can also enroll your existing company-owned laptops and even securely manage company data on employees' personal devices (BYOD) without invading their privacy.",
  },
  {
    question: "What happens if an employee loses their company laptop?",
    answer:
      "Because we manage your devices via Microsoft Intune and Entra ID, we can instantly lock the device, force a password reset, or remotely wipe all company data the moment it is reported lost or stolen. Your business data remains completely safe.",
  },
  {
    question:
      "Can you stop employees from logging in from unapproved locations?",
    answer:
      "Yes. Using Entra ID Conditional Access, we can block login attempts from specific countries, require multi-factor authentication (MFA) if the login looks suspicious, or only allow access from approved company devices.",
  },
  {
    question: "How do you handle employee onboarding and offboarding?",
    answer:
      "We automate it. When a new employee starts, they instantly get the right licenses, group access, and software. When someone leaves, one click revokes their access across all Microsoft 365 services, securing your data instantly.",
  },
];
---

<BaseLayout title={title} description={description} type="WebSite">
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      name: "Microsoft 365, Intune & Entra ID Management",
      provider: { "@type": "LocalBusiness", name: "IT Support Bee" },
      description: description,
      url: currentUrl,
      mainEntity: {
        "@type": "FAQPage",
        mainEntity: faqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      },
    })}
  />

  <!-- 1. HERO SECTION -->
  <section class="pt-32 pb-24 site-background site-background--accent border-t border-white/10"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span
          class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 bg-[#90ee02] text-[#2D058A] font-black uppercase tracking-widest text-sm border-2 border-[#2D058A] rounded-full shadow-[2px_2px_0px_0px_rgba(45,5,138,1)]"
        >
          <Icon name="lucide:shield-check" class="w-4 h-4" />
          Enterprise Workspace Security
        </span>
        <h1
          class="text-5xl md:text-7xl font-black text-[#2D058A] dark:text-white leading-tight mb-8"
        >
          Secure Your <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:from-[#90ee02] dark:to-[#ccff66]"
            >Microsoft 365 Cloud.</span
          >
        </h1>
        <p
          class="text-xl text-slate-700 dark:text-slate-300 font-medium mb-10 leading-relaxed"
        >
          Managing a remote workforce is dangerous without proper controls. We
          implement Microsoft Intune and Entra ID to lock down your company
          data, manage laptops remotely, and eliminate security breaches.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="px-10 py-5 bg-[#2D058A] dark:bg-[#90ee02] text-white dark:text-[#2D058A] font-black uppercase tracking-widest text-lg border-2 border-[#2D058A] dark:border-[#90ee02] rounded-xl shadow-[6px_6px_0px_0px_rgba(144,238,2,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.4)] hover:-translate-y-1 transition-all"
          >
            Secure Your Tenant Today
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THE PAIN POINT (Business Problems) -->
  <section class="py-24 site-background border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-8 uppercase tracking-tight"
      >
        Why Standard M365 Setup Isn't Enough
      </h2>
      <div class="prose prose-lg prose-slate dark:prose-invert max-w-none">
        <p class="font-medium text-lg leading-relaxed mb-6">
          Simply buying Microsoft 365 licenses and handing out email addresses
          leaves your business incredibly vulnerable. Without advanced
          administration, you have zero control over what happens to your
          company data once it hits an employee's device.
        </p>

        <div class="space-y-6">
          <div
            class="bg-red-50 dark:bg-red-900/10 border-l-8 border-red-500 p-6 rounded-r-xl"
          >
            <h3
              class="text-xl font-black text-red-700 dark:text-red-400 mb-2 mt-0"
            >
              Risk 1: The Remote Device Nightmare
            </h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">
              If a staff member loses their unmanaged laptop, whoever finds it
              can access your SharePoint files, client data, and emails. You
              have no way to wipe it remotely.
            </p>
          </div>

          <div
            class="bg-amber-50 dark:bg-amber-900/10 border-l-8 border-amber-500 p-6 rounded-r-xl"
          >
            <h3
              class="text-xl font-black text-amber-700 dark:text-amber-400 mb-2 mt-0"
            >
              Risk 2: Weak Identity Security
            </h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">
              Without Entra ID Conditional Access, hackers who steal an
              employee's password can log in from anywhere in the world and
              download your intellectual property.
            </p>
          </div>

          <div
            class="bg-blue-50 dark:bg-blue-900/10 border-l-8 border-blue-500 p-6 rounded-r-xl"
          >
            <h3
              class="text-xl font-black text-blue-700 dark:text-blue-400 mb-2 mt-0"
            >
              Risk 3: Manual IT Bottlenecks
            </h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">
              Setting up a new laptop for a hire takes your team hours of manual
              software installation. When they leave, removing their access
              across dozens of apps is chaotic and often forgotten.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. COMPARISON TABLE -->
  <section class="py-24 dark:border-white/10 site-background site-background--soft border-t border-white/10"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-12 text-center uppercase tracking-tight"
      >
        The Power of Managed Microsoft Cloud
      </h2>

      <div
        class="overflow-x-auto rounded-xl border-4 border-[#2D058A] shadow-[8px_8px_0px_0px_rgba(45,5,138,1)] bg-white dark:bg-[#150734]"
      >
        <table class="w-full text-left border-collapse">
          <thead>
            <tr>
              <th
                class="p-6 border-b-4 border-r-4 border-[#2D058A] bg-slate-50 dark:bg-[#0f0224] text-[#2D058A] dark:text-white font-black text-xl w-1/3"
                >Security Feature</th
              >
              <th
                class="p-6 border-b-4 border-r-4 border-[#2D058A] bg-slate-50 dark:bg-[#0f0224] text-slate-500 font-black text-xl w-1/3"
                >Basic Microsoft 365</th
              >
              <th
                class="p-6 border-b-4 border-[#2D058A] bg-[#90ee02] text-[#2D058A] font-black text-xl w-1/3"
                >With Intune & Entra ID</th
              >
            </tr>
          </thead>
          <tbody class="text-slate-700 dark:text-slate-300 font-medium">
            <tr>
              <td
                class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Device Setup</td
              >
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]"
                >Manual installation by an IT guy</td
              >
              <td
                class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10"
                >Zero-touch setup over Wi-Fi (Autopilot)</td
              >
            </tr>
            <tr>
              <td
                class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Lost Laptops</td
              >
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]"
                >Data is compromised permanently</td
              >
              <td
                class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10"
                >Remote wipe and instant device lockout</td
              >
            </tr>
            <tr>
              <td
                class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Access Control</td
              >
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]"
                >Anyone with a password can log in</td
              >
              <td
                class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10"
                >Blocked by location, device, and strict MFA</td
              >
            </tr>
            <tr>
              <td
                class="p-6 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Data Leakage (BYOD)</td
              >
              <td class="p-6 border-r-4 border-[#2D058A]"
                >Employees can download files to personal PCs</td
              >
              <td class="p-6 bg-green-50 dark:bg-green-900/10"
                >Company data is encrypted and isolated</td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 4. DEEP DIVE SERVICES -->
  <section class="py-24 site-background border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-16 text-center uppercase tracking-tight"
      >
        Our Core Administration Pillars
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Pillar 1 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <Icon name="lucide:smartphone" class="w-6 h-6 text-[#2D058A]" />
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Microsoft Intune (MDM & MAM)
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            We manage your fleet of devices from the cloud. Ship a sealed laptop
            directly from the store to a remote employee. The moment they
            connect to Wi-Fi, Microsoft Intune automatically installs your
            company apps, enforces BitLocker encryption, and applies security
            policies—zero manual IT work required.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <Icon name="lucide:fingerprint" class="w-6 h-6 text-[#2D058A]" />
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Entra ID (Identity Protection)
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            Passwords are no longer enough. We configure Entra ID (formerly
            Azure AD) with strict Conditional Access policies. We ensure users
            can only access company data if they are on a compliant device,
            using phishing-resistant MFA, and connecting from an approved
            geographical location.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <Icon name="lucide:users" class="w-6 h-6 text-[#2D058A]" />
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              M365 Administration & Licensing
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            Stop overpaying for orphaned licenses. We handle the daily
            operations: creating shared mailboxes, structuring SharePoint
            permissions, and establishing flawless onboarding/offboarding
            workflows so departing employees lose access instantly without
            deleting historical data.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <Icon name="lucide:shield-alert" class="w-6 h-6 text-[#2D058A]" />
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Data Loss Prevention (DLP)
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            We build fences around your sensitive data. Our DLP configurations
            prevent employees from accidentally (or maliciously) forwarding
            confidential client lists, credit card numbers, or intellectual
            property to personal email addresses or unauthorized external
            domains.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ SECTION -->
  <section class="py-24 dark:border-white/10 site-background site-background--soft border-t border-white/10"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-12 text-center uppercase tracking-tight"
      >
        Common Questions
      </h2>
      <div class="space-y-6">
        {
          faqs.map((faq) => (
            <details class="group bg-white dark:bg-[#150734] border-4 border-[#2D058A] dark:border-white/10 rounded-xl overflow-hidden shadow-[4px_4px_0px_0px_rgba(45,5,138,1)] dark:shadow-[4px_4px_0px_0px_rgba(144,238,2,0.3)]">
              <summary class="flex justify-between items-center font-black cursor-pointer list-none p-6 text-lg text-[#2D058A] dark:text-white hover:bg-slate-50 dark:hover:bg-[#2D058A] dark:hover:text-[#90ee02] transition-colors">
                {faq.question}
                <span class="transition group-open:rotate-180">
                  <Icon name="lucide:chevron-down" class="w-6 h-6" />
                </span>
              </summary>
              <div class="p-6 pt-0 text-slate-700 dark:text-slate-300 font-medium leading-relaxed border-t-2 border-slate-200 dark:border-white/5">
                {faq.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. HIGH-CONVERTING CTA -->
  <section class="py-24 site-background site-background--accent border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2
        class="text-4xl md:text-6xl font-black text-white mb-6 uppercase tracking-tighter"
      >
        Is Your Company Data Safe?
      </h2>
      <p class="text-xl text-slate-300 font-bold mb-12 max-w-2xl mx-auto">
        Stop relying on default settings. Let us configure Intune and Entra ID
        to lock down your Microsoft 365 environment against modern threats.
      </p>
      <a
        href="/contact"
        class="inline-block px-12 py-5 bg-[#2D058A] text-[#90ee02] font-black uppercase tracking-widest text-lg border-4 border-[#2D058A] rounded-xl shadow-[8px_8px_0px_0px_rgba(255,255,255,1)] hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(255,255,255,1)] transition-all"
      >
        Book a Security Audit
      </a>
    </div>
  </section>
</BaseLayout>
