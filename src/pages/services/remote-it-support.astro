---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Reliable Remote IT Support Services | IT Support Bee";
const description = "Stop wasting time fixing computer issues. Get a dedicated remote IT team that keeps your business running smoothly, securely, and without interruptions.";
const currentUrl = Astro.url.href;

const faqs = [
  {
    question: "What happens when an employee has a technical issue?",
    answer: "It's simple. Your employee sends us a message or opens a ticket, and our remote team connects to their computer securely within minutes to fix the problem. They don't have to wait hours for an 'IT guy' to drive to the office, meaning they get back to work much faster."
  },
  {
    question: "Is remote support as effective as having an on-site IT person?",
    answer: "Yes, in fact, it's often more efficient. Over 95% of daily IT problems—like email issues, software errors, password resets, and printer configurations—can be fixed completely remotely. You get the expertise of an entire IT department without the cost of hiring a full-time, in-house employee."
  },
  {
    question: "How do you protect our company data if you are working remotely?",
    answer: "Security is our top priority. We use encrypted, enterprise-grade tools to connect to your systems. We also proactively monitor your computers for viruses, enforce strong password policies, and ensure your data is backed up safely so it never falls into the wrong hands."
  },
  {
    question: "Do we have to pay a huge unexpected bill every time something breaks?",
    answer: "No. Traditional 'break-fix' IT guys charge you by the hour, which means they actually make more money when your business breaks down. We offer predictable support plans. We proactively maintain your systems so they don't break in the first place, keeping your monthly costs stable and manageable."
  }
];
---

<BaseLayout title={title} description={description} type="WebSite">
  
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Remote IT Support Services",
    "provider": { "@type": "LocalBusiness", "name": "IT Support Bee" },
    "description": description,
    "url": currentUrl,
    "mainEntity": {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
      }))
    }
  })} />

  <!-- 1. HERO SECTION (Business Value Focused) -->
  <section class="pt-32 pb-24 site-background site-background--accent border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="inline-block px-4 py-1.5 mb-6 bg-[#90ee02] text-[#2D058A] font-black uppercase tracking-widest text-sm border-2 border-[#2D058A] rounded-full shadow-[2px_2px_0px_0px_rgba(45,5,138,1)]">
          Managed IT Services
        </span>
        <h1 class="text-5xl md:text-7xl font-black text-[#2D058A] dark:text-white leading-tight mb-8">
          Stop Fighting Technology. <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:from-[#90ee02] dark:to-[#ccff66]">Get Back to Business.</span>
        </h1>
        <p class="text-xl text-slate-700 dark:text-slate-300 font-medium mb-10 leading-relaxed">
          Every minute your team spends trying to fix computer glitches, reset passwords, or recover lost files is a minute they aren't working. We provide fast, reliable remote IT support so your business runs smoothly, securely, and without frustrating interruptions.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="px-10 py-5 bg-[#2D058A] dark:bg-[#90ee02] text-white dark:text-[#2D058A] font-black uppercase tracking-widest text-lg border-2 border-[#2D058A] dark:border-[#90ee02] rounded-xl shadow-[6px_6px_0px_0px_rgba(144,238,2,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.4)] hover:-translate-y-1 transition-all">
            Get IT Support Today
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THE PAIN POINT (Business Problems) -->
  <section class="py-24 site-background border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-8 uppercase tracking-tight">
        Why Unmanaged IT is Hurting Your Business
      </h2>
      <div class="prose prose-lg prose-slate dark:prose-invert max-w-none">
        <p class="font-medium text-lg leading-relaxed mb-6">
          Many business owners try to handle IT issues themselves or rely on the most "tech-savvy" employee in the office. This creates a hidden drain on your company's time and money.
        </p>
        <p class="font-medium text-lg leading-relaxed mb-8">
          When technology fails, work stops. If you only call for help after a disaster happens, you are already losing money from downtime and risking permanent data loss.
        </p>
        
        <div class="space-y-6">
          <div class="bg-red-50 dark:bg-red-900/10 border-l-8 border-red-500 p-6 rounded-r-xl">
            <h3 class="text-xl font-black text-red-700 dark:text-red-400 mb-2 mt-0">Problem 1: Expensive Employee Downtime</h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">If a key employee can't access their email or a critical software crashes, they are sitting idle. You are paying them a full salary to wait for a computer to be fixed.</p>
          </div>
          
          <div class="bg-amber-50 dark:bg-amber-900/10 border-l-8 border-amber-500 p-6 rounded-r-xl">
            <h3 class="text-xl font-black text-amber-700 dark:text-amber-400 mb-2 mt-0">Problem 2: Hidden Security Risks</h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">Without active monitoring, your business is a prime target for ransomware and phishing attacks. One wrong click by an employee can expose your confidential client data to hackers.</p>
          </div>
          
          <div class="bg-blue-50 dark:bg-blue-900/10 border-l-8 border-blue-500 p-6 rounded-r-xl">
            <h3 class="text-xl font-black text-blue-700 dark:text-blue-400 mb-2 mt-0">Problem 3: Unpredictable Bills</h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">Hiring an IT guy only when things break means you get hit with massive, unexpected bills during emergencies. It makes it impossible to budget your business expenses properly.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. COMPARISON TABLE (Value Focus) -->
  <section class="py-24 dark:border-white/10 site-background site-background--soft border-t border-white/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-slate-800 mb-12 text-center uppercase tracking-tight">
        A Better Way to Manage Technology
      </h2>
      
      <div class="overflow-x-auto rounded-xl border-4 border-[#2D058A] shadow-[8px_8px_0px_0px_rgba(45,5,138,1)] bg-white dark:bg-[#150734]">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr>
              <th class="p-6 border-b-4 border-r-4 border-[#2D058A] bg-slate-50 dark:bg-[#0f0224] text-[#2D058A] dark:text-white font-black text-xl w-1/3">Business Goal</th>
              <th class="p-6 border-b-4 border-r-4 border-[#2D058A] bg-slate-50 dark:bg-[#0f0224] text-slate-500 font-black text-xl w-1/3">Traditional "Break-Fix" IT</th>
              <th class="p-6 border-b-4 border-[#2D058A] bg-[#90ee02] text-[#2D058A] font-black text-xl w-1/3">With IT Support Bee</th>
            </tr>
          </thead>
          <tbody class="text-slate-700 dark:text-slate-300 font-medium">
            <tr>
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white">Speed of Support</td>
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]">Wait hours or days for someone to visit</td>
              <td class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10">Instant remote help within minutes</td>
            </tr>
            <tr>
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white">Approach to Problems</td>
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]">Only fixes things after they crash</td>
              <td class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10">Proactive monitoring to stop crashes early</td>
            </tr>
            <tr>
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white">Data Security</td>
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]">Basic antivirus, high risk of data loss</td>
              <td class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10">Strict backups and enterprise security</td>
            </tr>
            <tr>
              <td class="p-6 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white">Cost Management</td>
              <td class="p-6 border-r-4 border-[#2D058A]">Surprise hourly bills during emergencies</td>
              <td class="p-6 bg-green-50 dark:bg-green-900/10">Predictable, flat-rate monthly support</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 4. DEEP DIVE SERVICES (How we solve the problems) -->
  <section class="py-24 site-background border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-16 text-center uppercase tracking-tight">
        How We Protect Your Business
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        
        <!-- Pillar 1 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-[#2D058A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">Fast, Remote Helpdesk</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4">
            When an employee has a computer issue, they don't have to wait. We securely connect to their screen and fix the issue right in front of their eyes. This drastically reduces downtime, keeping your staff happy and productive without the hassle of scheduling on-site visits.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-[#2D058A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">Proactive System Monitoring</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4">
            We don't wait for things to break. We quietly monitor your computers, networks, and cloud systems in the background. If a hard drive is about to fail or a software needs a critical update, we fix it before it ever causes a disruption to your daily operations.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-[#2D058A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">Bulletproof Data Protection</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4">
            Your client data is your most valuable asset. We lock down your systems with advanced security protocols, enforce safe password practices, and ensure your business files are securely backed up. If an accident happens, we can restore your data instantly.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-[#2D058A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">Employee Onboarding</h3>
          </div>
          <p class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4">
            When you hire someone new, we handle all the technical setup. We create their email accounts, grant them the correct access to company folders, and ensure their computer is fully prepped so they can start being productive on their very first day.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. AEO FAQ SECTION (Fix applied to hover state) -->
  <section class="py-24 dark:border-white/10 site-background site-background--soft border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-12 text-center uppercase tracking-tight">
        Common Questions
      </h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <details class="group bg-white dark:bg-[#150734] border-4 border-[#2D058A] dark:border-white/10 rounded-xl overflow-hidden shadow-[4px_4px_0px_0px_rgba(45,5,138,1)] dark:shadow-[4px_4px_0px_0px_rgba(144,238,2,0.3)]">
            
            <!-- Hover bug fixed here: dark:hover:bg-[#2D058A] and dark:hover:text-[#90ee02] -->
            <summary class="flex justify-between items-center font-black cursor-pointer list-none p-6 text-lg text-[#2D058A] dark:text-white hover:bg-slate-50 dark:hover:bg-[#2D058A] dark:hover:text-[#90ee02] transition-colors">
              {faq.question}
              <span class="transition group-open:rotate-180">
                <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
              </span>
            </summary>
            
            <div class="p-6 pt-0 text-slate-700 dark:text-slate-300 font-medium leading-relaxed border-t-2 border-slate-200 dark:border-white/5">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. HIGH-CONVERTING CTA -->
  <section class="py-24 site-background site-background--accent border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-4xl md:text-6xl font-black text-white mb-6 uppercase tracking-tighter">
        Ready for Hassle-Free IT?
      </h2>
      <p class="text-xl text-slate-300 font-bold mb-12 max-w-2xl mx-auto">
        Stop letting tech issues slow down your team. Let us secure and support your business so you can focus on growing it.
      </p>
      <a href="/contact" class="inline-block px-12 py-5 bg-[#2D058A] text-[#90ee02] font-black uppercase tracking-widest text-lg border-4 border-[#2D058A] rounded-xl shadow-[8px_8px_0px_0px_rgba(255,255,255,1)] hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(255,255,255,1)] transition-all">
        Get an IT Assessment
      </a>
    </div>
  </section>

</BaseLayout>
