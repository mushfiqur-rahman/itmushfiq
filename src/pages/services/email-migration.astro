---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Enterprise Email Migration Services | IT Support Bee";
const description =
  "Zero-downtime email migrations. We specialize in Exchange Online to Google Workspace, GoDaddy Microsoft 365 defederation, and complex tenant consolidations.";
const currentUrl = Astro.url.href;

const faqs = [
  {
    question: "What does zero-downtime migration actually mean?",
    answer:
      "It means your team will never stop receiving or sending emails. We use a staged approach, configuring temporary routing domains and dual-delivery systems. We do the heavy data synchronization in the background and only switch the live MX records during scheduled off-hours (usually a weekend).",
  },
  {
    question: "How do you handle GoDaddy Microsoft 365 Defederation?",
    answer:
      "GoDaddy locks down your Microsoft 365 admin panel, forcing you to pay higher renewal fees. We use advanced PowerShell scripts and the Microsoft.Graph.Identity.DirectoryManagement module to sever the backend connection. This transfers full global admin rights directly to you on Microsoft's native platform, without migrating a single mailbox.",
  },
  {
    question: "Can you migrate our folders, labels, and calendar events?",
    answer:
      "Yes. Whether moving from Exchange Online to Workspace or consolidating multiple Google tenants, we map your entire folder hierarchy, calendar events, contacts, and custom labels so your employees log in on Monday morning with everything exactly where they left it.",
  },
  {
    question: "What happens to emails sent to us during the DNS transition?",
    answer:
      "We set up catch-all rules and custom routing vaults before the MX records are updated. Any email that arrives during the DNS propagation window is safely captured in a quarantine vault or routed to the new destination, guaranteeing zero data loss.",
  },
];
---

<BaseLayout title={title} description={description} type="WebSite">
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      name: "Enterprise Email Migration",
      provider: { "@type": "LocalBusiness", name: "IT Support Bee" },
      description: description,
      url: currentUrl,
      mainEntity: {
        "@type": "FAQPage",
        mainEntity: faqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      },
    })}
  />

  <!-- 1. HERO SECTION (Extended for SEO) -->
  <section class="pt-32 pb-24 site-background site-background--accent border-t border-white/10"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span
          class="inline-block px-4 py-1.5 mb-6 bg-[#90ee02] text-[#2D058A] font-black uppercase tracking-widest text-sm border-2 border-[#2D058A] rounded-full shadow-[2px_2px_0px_0px_rgba(45,5,138,1)]"
        >
          Cloud Infrastructure Migration
        </span>
        <h1
          class="text-5xl md:text-7xl font-black text-[#2D058A] dark:text-white leading-tight mb-8"
        >
          Flawless Email Migrations. <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:from-[#90ee02] dark:to-[#ccff66]"
            >Zero Data Loss.</span
          >
        </h1>
        <p
          class="text-xl text-slate-700 dark:text-slate-300 font-medium mb-10 leading-relaxed"
        >
          Email is the lifeblood of your business. We execute complex cloud
          migrations—from GoDaddy tenant defederations to massive
          Exchange-to-Workspace moves—with military precision. Your team leaves
          on Friday and logs into a perfectly mapped, secure new environment on
          Monday morning.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="px-10 py-5 bg-[#2D058A] dark:bg-[#90ee02] text-white dark:text-[#2D058A] font-black uppercase tracking-widest text-lg border-2 border-[#2D058A] dark:border-[#90ee02] rounded-xl shadow-[6px_6px_0px_0px_rgba(144,238,2,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.4)] hover:-translate-y-1 transition-all"
          >
            Plan Your Migration
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THE PAIN POINT (In-depth problem explanation for SEO) -->
  <section class="py-24 site-background border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-8 uppercase tracking-tight"
      >
        The Risks of a Bad Migration
      </h2>
      <div class="prose prose-lg prose-slate dark:prose-invert max-w-none">
        <p class="font-medium text-lg leading-relaxed mb-6">
          Migrating enterprise email is not as simple as copying files from one
          hard drive to another. It requires a deep understanding of DNS
          propagation, mail routing architecture, and backend API limitations.
        </p>
        <p class="font-medium text-lg leading-relaxed mb-8">
          When businesses attempt DIY migrations or hire inexperienced IT
          admins, they inevitably trigger catastrophic operational failures that
          cost time, money, and client trust.
        </p>

        <div class="space-y-6">
          <div
            class="bg-red-50 dark:bg-red-900/10 border-l-8 border-red-500 p-6 rounded-r-xl"
          >
            <h3
              class="text-xl font-black text-red-700 dark:text-red-400 mb-2 mt-0"
            >
              Lost Emails & Silent Bounces
            </h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">
              If MX records are changed prematurely or without a dual-delivery
              routing setup, incoming client emails will silently bounce during
              the 24-48 hour DNS propagation window. You will never know what
              important messages you missed.
            </p>
          </div>

          <div
            class="bg-amber-50 dark:bg-amber-900/10 border-l-8 border-amber-500 p-6 rounded-r-xl"
          >
            <h3
              class="text-xl font-black text-amber-700 dark:text-amber-400 mb-2 mt-0"
            >
              The GoDaddy Vendor Lock-in
            </h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">
              If you bought Microsoft 365 through GoDaddy, you don't have true
              admin access. Attempting to migrate out manually often leads to
              days of downtime. We bypass this using specialized PowerShell
              scripts to defederate your tenant natively.
            </p>
          </div>

          <div
            class="bg-blue-50 dark:bg-blue-900/10 border-l-8 border-blue-500 p-6 rounded-r-xl"
          >
            <h3
              class="text-xl font-black text-blue-700 dark:text-blue-400 mb-2 mt-0"
            >
              Broken Folder Structures
            </h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">
              Standard IMAP migrations pull the emails but destroy the folder
              hierarchy and calendar data. Employees log in to find a massive,
              unorganized inbox, completely halting their productivity for days.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. COMPARISON TABLE (Trust building & decision making) -->
  <section class="py-24 dark:border-white/10 site-background site-background--soft border-t border-white/10"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-12 text-center uppercase tracking-tight"
      >
        Why Clients Trust Our Process
      </h2>

      <div
        class="overflow-x-auto rounded-xl border-4 border-[#2D058A] shadow-[8px_8px_0px_0px_rgba(45,5,138,1)] bg-white dark:bg-[#150734]"
      >
        <table class="w-full text-left border-collapse">
          <thead>
            <tr>
              <th
                class="p-6 border-b-4 border-r-4 border-[#2D058A] bg-slate-50 dark:bg-[#0f0224] text-[#2D058A] dark:text-white font-black text-xl w-1/3"
                >Migration Metric</th
              >
              <th
                class="p-6 border-b-4 border-r-4 border-[#2D058A] bg-slate-50 dark:bg-[#0f0224] text-slate-500 font-black text-xl w-1/3"
                >Standard IT Agency</th
              >
              <th
                class="p-6 border-b-4 border-[#2D058A] bg-[#90ee02] text-[#2D058A] font-black text-xl w-1/3"
                >With IT Support Bee</th
              >
            </tr>
          </thead>
          <tbody class="text-slate-700 dark:text-slate-300 font-medium">
            <tr>
              <td
                class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Business Downtime</td
              >
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]"
                >12 to 48 hours</td
              >
              <td
                class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10"
                >Zero downtime (Weekend Cutover)</td
              >
            </tr>
            <tr>
              <td
                class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Data Fidelity</td
              >
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]"
                >Emails only (IMAP)</td
              >
              <td
                class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10"
                >Emails, Folders, Calendars, Contacts</td
              >
            </tr>
            <tr>
              <td
                class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >GoDaddy Support</td
              >
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]"
                >Requires manual mailbox export</td
              >
              <td
                class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10"
                >Native backend defederation</td
              >
            </tr>
            <tr>
              <td
                class="p-6 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Email Deliverability</td
              >
              <td class="p-6 border-r-4 border-[#2D058A]">Basic MX update</td>
              <td class="p-6 bg-green-50 dark:bg-green-900/10"
                >Full SPF, DKIM & DMARC alignment</td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 4. DEEP DIVE SERVICES (Pillar Content) -->
  <section class="py-24 site-background border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-16 text-center uppercase tracking-tight"
      >
        Core Migration Capabilities
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Pillar 1 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <svg
                class="w-6 h-6 text-[#2D058A]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                ></path></svg
              >
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Cross-Platform Transitions
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            Whether you are moving from Microsoft Exchange Online to Google
            Workspace, or migrating from a legacy cPanel/Webmail server to
            Microsoft 365, we handle the entire API-level data transfer. We
            ensure every label, nested folder, and recurring calendar invite is
            perfectly mapped to the new environment.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <svg
                class="w-6 h-6 text-[#2D058A]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
              >
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              GoDaddy Defederation
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            GoDaddy limits your administrative control over Microsoft 365. We
            execute precise PowerShell scripts using the Microsoft Graph API to
            defederate your tenant. This breaks the link with GoDaddy and
            restores your native global admin privileges instantly—without
            requiring a single mailbox to be moved or downloaded.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <svg
                class="w-6 h-6 text-[#2D058A]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                ></path></svg
              >
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Tenant Consolidation
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            Did you acquire a new company? We merge multiple Google Workspace or
            Microsoft 365 environments into a single, unified corporate tenant.
            We manage the complex domain verifications, establish primary and
            secondary domains, and consolidate user identities without
            disrupting cross-department communication.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <svg
                class="w-6 h-6 text-[#2D058A]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path></svg
              >
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Custom Routing & Vaults
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            For complex enterprise setups, a simple cutover isn't enough. We
            build advanced content compliance rules, setup quarantine vaults,
            and configure dual-delivery routing for secondary domain aliases.
            This ensures strict data security and compliance policies remain
            intact during and after the transition.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. AEO FAQ SECTION (Expanded) -->
  <section class="py-24 dark:border-white/10 site-background site-background--soft border-t border-white/10"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-12 text-center uppercase tracking-tight"
      >
        Common Questions
      </h2>
      <div class="space-y-6">
        {
          faqs.map((faq) => (
            <details class="group bg-white dark:bg-[#150734] border-4 border-[#2D058A] dark:border-white/10 rounded-xl overflow-hidden shadow-[4px_4px_0px_0px_rgba(45,5,138,1)] dark:shadow-[4px_4px_0px_0px_rgba(144,238,2,0.3)]">
              <summary class="flex justify-between items-center font-black cursor-pointer list-none p-6 text-lg text-[#2D058A] dark:text-white hover:bg-slate-50 dark:hover:bg-[#2D058A] dark:hover:text-[#90ee02] transition-colors">
                {faq.question}
                <span class="transition group-open:rotate-180">
                  <svg
                    fill="none"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    viewBox="0 0 24 24"
                    width="24"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <div class="p-6 pt-0 text-slate-700 dark:text-slate-300 font-medium leading-relaxed border-t-2 border-slate-200 dark:border-white/5">
                {faq.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. HIGH-CONVERTING CTA -->
  <section class="py-24 site-background site-background--accent border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2
        class="text-4xl md:text-6xl font-black text-white mb-6 uppercase tracking-tighter"
      >
        Ready for a Smooth Move?
      </h2>
      <p class="text-xl text-slate-300 font-bold mb-12 max-w-2xl mx-auto">
        Don't risk your company's data with a DIY migration. Let us plan and
        execute a flawless transition this weekend.
      </p>
      <a
        href="/contact"
        class="inline-block px-12 py-5 bg-[#2D058A] text-[#90ee02] font-black uppercase tracking-widest text-lg border-4 border-[#2D058A] rounded-xl shadow-[8px_8px_0px_0px_rgba(255,255,255,1)] hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(255,255,255,1)] transition-all"
      >
        Book a Migration Audit
      </a>
    </div>
  </section>
</BaseLayout>
