---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Google Workspace Management Services | IT Support Bee";
const description =
  "Comprehensive Google Workspace management, security audits, and optimization for growing businesses. Stop data leaks and streamline your IT infrastructure.";
const currentUrl = Astro.url.href;

const faqs = [
  {
    question: "What exactly does a Google Workspace Manager do?",
    answer:
      "A Google Workspace Manager takes full control of your Google environment. This includes provisioning new user accounts, configuring DNS (SPF, DKIM, DMARC), managing Google Drive hierarchies, setting up Data Loss Prevention (DLP) rules, handling mobile device management (MDM), and providing day-to-day helpdesk support for your employees.",
  },
  {
    question: "How do you handle employee onboarding and offboarding?",
    answer:
      "We follow a strict, documented protocol. For onboarding, we create the account, assign the correct license, add them to relevant Google Groups, set up their email signature, and grant specific Drive permissions. For offboarding, we immediately suspend access, wipe company data from their mobile devices, archive their emails using Google Vault, and transfer their Drive files to a manager before deleting the account to save license costs.",
  },
  {
    question: "Why can't I just manage Google Workspace myself?",
    answer:
      "While the basic setup is simple, scaling is complex. Without professional management, businesses often face data leaks from incorrect Drive sharing, spoofed emails due to missing DNS records, and wasted money on unused licenses. We ensure enterprise-grade security and compliance so you can focus on your business.",
  },
  {
    question:
      "How do you secure our Google Drive data from internal and external threats?",
    answer:
      "We transition your team from 'My Drive' to 'Shared Drives' to ensure the company owns all data. We remove broad 'anyone with the link' sharing options, enforce 2-Step Verification (2SV) company-wide, and set up DLP (Data Loss Prevention) rules to block the sharing of sensitive information like credit card numbers or PII.",
  },
];
---

<BaseLayout title={title} description={description} type="WebSite">
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      name: "Google Workspace Management",
      provider: { "@type": "LocalBusiness", name: "IT Support Bee" },
      description: description,
      url: currentUrl,
      mainEntity: {
        "@type": "FAQPage",
        mainEntity: faqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      },
    })}
  />

  <!-- 1. HERO SECTION (Extended for SEO) -->
  <section
    class="pt-32 pb-24 bg-slate-50 dark:bg-[#0f0224] border-b-4 border-[#2D058A]"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span
          class="inline-block px-4 py-1.5 mb-6 bg-[#90ee02] text-[#2D058A] font-black uppercase tracking-widest text-sm border-2 border-[#2D058A] rounded-full shadow-[2px_2px_0px_0px_rgba(45,5,138,1)]"
        >
          Managed Cloud Infrastructure
        </span>
        <h1
          class="text-5xl md:text-7xl font-black text-[#2D058A] dark:text-white leading-tight mb-8"
        >
          Enterprise-Grade <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:from-[#90ee02] dark:to-[#ccff66]"
            >Google Workspace</span
          > Management.
        </h1>
        <p
          class="text-xl text-slate-700 dark:text-slate-300 font-medium mb-10 leading-relaxed"
        >
          Most businesses use less than 20% of Google Workspace's actual
          capabilities while leaving their data highly vulnerable. We take full
          ownership of your Workspace infrastructure—from advanced security
          compliance and Drive architecture to automated employee onboarding and
          day-to-day IT helpdesk support.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="px-10 py-5 bg-[#2D058A] dark:bg-[#90ee02] text-white dark:text-[#2D058A] font-black uppercase tracking-widest text-lg border-2 border-[#2D058A] dark:border-[#90ee02] rounded-xl shadow-[6px_6px_0px_0px_rgba(144,238,2,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.4)] hover:-translate-y-1 transition-all"
          >
            Get a Free Workspace Audit
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THE PAIN POINT (In-depth problem explanation for SEO) -->
  <section class="py-24 bg-white dark:bg-[#150734]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-8 uppercase tracking-tight"
      >
        The Hidden Risks of an Unmanaged Workspace
      </h2>
      <div class="prose prose-lg prose-slate dark:prose-invert max-w-none">
        <p class="font-medium text-lg leading-relaxed mb-6">
          Setting up Google Workspace (formerly G Suite) is incredibly easy. You
          buy a domain, add a few users, and you have email. But as your
          business grows, this "DIY" setup becomes a massive security and
          operational liability.
        </p>
        <p class="font-medium text-lg leading-relaxed mb-8">
          Without a dedicated administrator, companies inevitably run into a
          specific set of critical problems that disrupt workflows and expose
          sensitive company data to the public internet.
        </p>

        <div class="space-y-6">
          <div
            class="bg-red-50 dark:bg-red-900/10 border-l-8 border-red-500 p-6 rounded-r-xl"
          >
            <h3
              class="text-xl font-black text-red-700 dark:text-red-400 mb-2 mt-0"
            >
              Data Leaks Through "My Drive"
            </h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">
              When employees use "My Drive" instead of "Shared Drives", they
              personally own the files they create. If that employee leaves or
              is terminated, deleting their account deletes all the company
              documents they created. Furthermore, files shared with "Anyone
              with the link" remain indexed on Google, exposing confidential
              data.
            </p>
          </div>

          <div
            class="bg-amber-50 dark:bg-amber-900/10 border-l-8 border-amber-500 p-6 rounded-r-xl"
          >
            <h3
              class="text-xl font-black text-amber-700 dark:text-amber-400 mb-2 mt-0"
            >
              Wasted License Spending
            </h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">
              Businesses frequently pay for Google Workspace licenses they don't
              actually need. Keeping a former employee's account active just to
              forward their emails is a common, expensive mistake. We convert
              these to free aliases or Cloud Identity licenses, saving you
              hundreds of dollars annually.
            </p>
          </div>

          <div
            class="bg-blue-50 dark:bg-blue-900/10 border-l-8 border-blue-500 p-6 rounded-r-xl"
          >
            <h3
              class="text-xl font-black text-blue-700 dark:text-blue-400 mb-2 mt-0"
            >
              Authentication & Deliverability Failures
            </h3>
            <p class="text-slate-700 dark:text-slate-300 m-0">
              If your Google Workspace isn't properly configured with strict
              SPF, DKIM, and DMARC policies in your DNS settings, your
              legitimate business emails will land in your clients' spam
              folders, and malicious actors can easily spoof your domain.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. COMPARISON TABLE (Trust building & decision making) -->
  <section
    class="py-24 bg-slate-100 dark:bg-[#0a0118] border-y-4 border-[#2D058A] dark:border-white/10"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-12 text-center uppercase tracking-tight"
      >
        The Smart Choice for Growing Teams
      </h2>

      <div
        class="overflow-x-auto rounded-xl border-4 border-[#2D058A] shadow-[8px_8px_0px_0px_rgba(45,5,138,1)] bg-white dark:bg-[#150734]"
      >
        <table class="w-full text-left border-collapse">
          <thead>
            <tr>
              <th
                class="p-6 border-b-4 border-r-4 border-[#2D058A] bg-slate-50 dark:bg-[#0f0224] text-[#2D058A] dark:text-white font-black text-xl w-1/3"
                >Features</th
              >
              <th
                class="p-6 border-b-4 border-r-4 border-[#2D058A] bg-slate-50 dark:bg-[#0f0224] text-slate-500 font-black text-xl w-1/3"
                >DIY / Unmanaged</th
              >
              <th
                class="p-6 border-b-4 border-[#2D058A] bg-[#90ee02] text-[#2D058A] font-black text-xl w-1/3"
                >With IT Support Bee</th
              >
            </tr>
          </thead>
          <tbody class="text-slate-700 dark:text-slate-300 font-medium">
            <tr>
              <td
                class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Security & 2FA</td
              >
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]"
                >Optional (Users often disable it)</td
              >
              <td
                class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10"
                >Strictly Enforced Company-wide</td
              >
            </tr>
            <tr>
              <td
                class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Onboarding Time</td
              >
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]"
                >Hours of manual setup</td
              >
              <td
                class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10"
                >Automated within 15 minutes</td
              >
            </tr>
            <tr>
              <td
                class="p-6 border-b-2 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >Data Ownership</td
              >
              <td class="p-6 border-b-2 border-r-4 border-[#2D058A]"
                >Scattered across personal drives</td
              >
              <td
                class="p-6 border-b-2 border-[#2D058A] bg-green-50 dark:bg-green-900/10"
                >Centralized in Shared Drives</td
              >
            </tr>
            <tr>
              <td
                class="p-6 border-r-4 border-[#2D058A] font-bold text-[#2D058A] dark:text-white"
                >License Costs</td
              >
              <td class="p-6 border-r-4 border-[#2D058A]"
                >Paying for unused/ex-employees</td
              >
              <td class="p-6 bg-green-50 dark:bg-green-900/10"
                >Optimized & frequently audited</td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 4. DEEP DIVE SERVICES (Pillar Content) -->
  <section class="py-24 bg-white dark:bg-[#150734]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-16 text-center uppercase tracking-tight"
      >
        Comprehensive Workspace Administration
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Pillar 1 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <svg
                class="w-6 h-6 text-[#2D058A]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                ></path></svg
              >
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Advanced Security & DLP
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            We implement zero-trust security policies across your organization.
            This includes enforcing 2-Step Verification, configuring
            context-aware access (blocking logins from outside specific
            countries), and establishing Data Loss Prevention (DLP) rules. If an
            employee tries to email a credit card number or download massive
            amounts of data, the system automatically blocks the action and
            alerts us.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <svg
                class="w-6 h-6 text-[#2D058A]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path></svg
              >
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Flawless User Lifecycle
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            Onboarding should be magic, not a headache. We handle the entire IT
            side of HR. When a new hire starts, their email, groups, calendar
            access, and Drive permissions are ready on day one. When someone
            leaves, our strict offboarding protocol immediately revokes access,
            secures their emails, and archives their data without paying for an
            active Google Workspace license.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <svg
                class="w-6 h-6 text-[#2D058A]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                ></path></svg
              >
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Drive & Storage Architecture
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            We migrate your team away from messy personal drives into a
            structured Shared Drive hierarchy. We implement strict, folder-level
            permissions ensuring the marketing team can't access HR files, and
            external contractors can only view specific documents without the
            ability to download or print them.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div>
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-12 h-12 bg-[#90ee02] border-2 border-[#2D058A] rounded-lg flex items-center justify-center shrink-0"
            >
              <svg
                class="w-6 h-6 text-[#2D058A]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"
                ></path></svg
              >
            </div>
            <h3 class="text-2xl font-black text-[#2D058A] dark:text-[#90ee02]">
              Daily IT Helpdesk Support
            </h3>
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed mb-4"
          >
            Consider us your in-house IT department, operating remotely. Your
            employees can reach out directly for daily technical issues—from
            resetting passwords and recovering deleted files to troubleshooting
            Google Meet audio issues and configuring third-party marketplace
            apps.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. AEO FAQ SECTION (Expanded) -->
  <section
    class="py-24 bg-slate-50 dark:bg-[#0f0224] border-t-4 border-[#2D058A] dark:border-white/10"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-3xl md:text-5xl font-black text-[#2D058A] dark:text-white mb-12 text-center uppercase tracking-tight"
      >
        Common Questions
      </h2>
      <div class="space-y-6">
        {
          faqs.map((faq) => (
            <details class="group bg-white dark:bg-[#150734] border-4 border-[#2D058A] dark:border-white/10 rounded-xl overflow-hidden shadow-[4px_4px_0px_0px_rgba(45,5,138,1)] dark:shadow-[4px_4px_0px_0px_rgba(144,238,2,0.3)]">
              <summary class="flex justify-between items-center font-black cursor-pointer list-none p-6 text-lg text-[#2D058A] dark:text-white hover:bg-slate-50 dark:hover:bg-[#2D058A] dark:hover:text-[#90ee02] transition-colors">
                {faq.question}
                <span class="transition group-open:rotate-180">
                  <svg
                    fill="none"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    viewBox="0 0 24 24"
                    width="24"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <div class="p-6 pt-0 text-slate-700 dark:text-slate-300 font-medium leading-relaxed border-t-2 border-slate-200 dark:border-white/5">
                {faq.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. HIGH-CONVERTING CTA -->
  <section class="py-24 bg-[#90ee02] border-t-4 border-[#2D058A]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2
        class="text-4xl md:text-6xl font-black text-[#2D058A] mb-6 uppercase tracking-tighter"
      >
        Ready to Secure Your Cloud?
      </h2>
      <p class="text-xl text-[#2D058A]/80 font-bold mb-12 max-w-2xl mx-auto">
        Stop managing IT yourself. Let us optimize your Google Workspace so your
        team can work securely and efficiently.
      </p>
      <a
        href="/contact"
        class="inline-block px-12 py-5 bg-[#2D058A] text-[#90ee02] font-black uppercase tracking-widest text-lg border-4 border-[#2D058A] rounded-xl shadow-[8px_8px_0px_0px_rgba(255,255,255,1)] hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(255,255,255,1)] transition-all"
      >
        Book a Discovery Call
      </a>
    </div>
  </section>
</BaseLayout>
