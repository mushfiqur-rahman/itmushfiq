---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { Icon } from 'astro-icon/components';


const education = [
  {
    degree: "Bachelor of Science (B.Sc) in Computer Science & Engineering",
    institution: "National University, Bangladesh",
    year: "Graduated"
  }
];

const certifications = [
  {
    title: "AI Fundamental",
    issuer: "Google",
    image: "/certificates/AI Fundamental-BNHMV1XP27XX.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/BNHMV1XP27XX" 
  },
  {
    title: "HIPAA Fundamentals",
    issuer: "SkillUp",
    image: "/certificates/HIPAA Fundamentals.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/7RJAGDYQMH5P"
  },
  {
    title: "Introduction to Microsoft Azure Cloud Services",
    issuer: "Microsoft",
    image: "/certificates/Introduction to Microsoft Azure Cloud Services.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/WL9TYX2YBI8D"
  },
  {
    title: "MS-102: Microsoft 365 Administrator",
    issuer: "Packt",
    image: "/certificates/Microsoft 365 Administrator.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/VA55I5HN6LC6"
  },
  {
    title: "Google Workspace Administrator",
    issuer: "Google Cloud",
    image: "/certificates/Google Workspace Administrator.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/specialization/LTH01Q01M3ND"
  },
  {
    title: "Foundations of Cybersecurity",
    issuer: "Google",
    image: "/certificates/Foundations of Cybersecurity.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/PWZ8ZGLJFVHQ"
  },
  {
    title: "Planning for a Google Workspace Deployment",
    issuer: "Google Cloud",
    image: "/certificates/Planning for a Google Workspace Deployment.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/XYWXS11GKC9V"
  },
  {
    title: "Fundamentals of Red Hat Enterprise Linux",
    issuer: "Red Hat",
    image: "/certificates/Fundamentals of Red Hat Enterprise Linux.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/YAA9RMASNSNJ"
  },
  {
    title: "Introduction to Computers",
    issuer: "Microsoft",
    image: "/certificates/Introduction to Computers.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/326FIAT22LFB"
  },
  {
    title: "IELTS",
    issuer: "British Council",
    image: "/certificates/IELTS.png",
    verifyLink: "https://ielts.org/organisations/ielts-for-organisations/verifying-ielts-results"
  }
];

const skills = ["Microsoft 365 Administration", "Google Workspace Administration", "Email Migration", "Email Deliverability", "DNS Security", "Astro", "Tailwind CSS", "WordPress", "Zapier & n8n", "Linux Server Admin", "Bash Scripting", "AWS Cloud Services", "Azure Cloud Services", "Cybersecurity Fundamentals", "IT Support & Troubleshooting", "CI/CD Automation", "Remote IT Support", "IT Infrastructure Optimization", "Cloud Security Best Practices", "IT Project Management"];
---

<BaseLayout title="About IT Support Bee | Your Remote IT Partner" description="Meet Mushfiqur Rahman, founder of IT Support Bee. Remote IT support, cloud administration, email migration, and automation built around your business.">
  <div class="about">
    <div class="shell">
      <section class="hero" aria-labelledby="about-title">
        <div class="hero-copy">
          <h1 id="about-title">Great businesses.<br/>Better IT.<br/><span>A human touch.</span></h1>
          <p class="intro">We take care of the technology.<br class="desktop-break"/> You take care of what comes next.</p>
          <p class="hero-description">IT Support Bee is a founder-led remote IT agency helping businesses simplify their cloud, secure their email, and keep work moving.</p>
          <div class="actions"><a class="button primary" href="/contact">Let’s talk about your IT <Icon name="lucide:arrow-up-right"/></a><a class="text-link" href="#our-story">Meet your IT partner <Icon name="lucide:arrow-down"/></a></div>
          <div class="hero-notes"><span><Icon name="lucide:globe"/> Remote by design</span><span><Icon name="lucide:shield-check"/> Security in mind</span></div>
        </div>
        <div class="hero-visual">
          <div class="portrait glass"><img src="/mushfiqur.jpg" alt="Mushfiqur Rahman, founder of IT Support Bee" width="600" height="720" fetchpriority="high"/><div class="portrait-shade"></div><span class="portrait-label"><span class="status-dot"></span> YOUR IT PARTNER</span><div class="portrait-name"><p>Mushfiqur Rahman</p><span>Founder · IT Support Bee</span></div></div>
          <div class="floating glass"><span class="icon-tile"><Icon name="lucide:shield-check"/></span><div><strong>Technical expertise.</strong><span>Personal accountability.</span></div></div>
          <div class="experience-chip glass"><strong>6<span>+</span></strong><p>years of hands-on<br/>IT experience</p></div>
        </div>
      </section>
      <div class="platforms"><span>EXPERTISE ACROSS YOUR EVERYDAY TOOLS</span><div><span><Icon name="lucide:cloud"/> Google Workspace</span><span><Icon name="lucide:layout-grid"/> Microsoft 365</span><span><Icon name="lucide:server"/> Cloud infrastructure</span></div></div>
      <section id="our-story" class="section" aria-labelledby="story-title">
        <div class="section-heading"><div><p class="eyebrow">SMALL TEAM ENERGY. BIG PICTURE THINKING.</p><h2 id="story-title">Your IT should move you forward.<br/><span>We’re here to make sure it does.</span></h2></div><p>Practical solutions. Clear communication.<br/>A partner who cares about the details.</p></div>
        <div class="bento">
          <article class="glass story"><span class="icon-tile"><Icon name="lucide:handshake"/></span><p class="eyebrow">A NOTE FROM THE FOUNDER</p><h3>Hi, I’m Mushfiq.<br/>Your technology, taken personally.</h3><p>I started IT Support Bee with a simple belief: reliable IT should give you the freedom to focus on your business.</p><p>With over six years in IT support and cloud administration, I turn complicated systems into secure, manageable infrastructure. From a tricky email migration to everyday troubleshooting, I bring the same care to every detail.</p><a class="text-link" href="/contact">Tell me what you’re working on <Icon name="lucide:arrow-up-right"/></a></article>
          <article class="glass purpose"><span class="icon-tile"><Icon name="lucide:crosshair"/></span><h3>Less friction.<br/>More focus.</h3><p>Our mission is to reduce downtime, improve email reliability, and automate repetitive work—so technology supports your growth.</p><div class="signal" aria-hidden="true"><span></span><span></span><span></span><Icon name="lucide:zap"/></div></article>
          <article class="glass remote"><span class="icon-tile"><Icon name="lucide:globe"/></span><h3>Remote-first.<br/>Always human.</h3><p>Based in Bangladesh. Working across borders. Direct conversations with the person solving your IT challenges.</p><span class="small-label">CONNECTED BY TRUST, NOT LOCATION</span></article>
          <article class="glass principles"><p class="eyebrow">HOW WE SHOW UP</p><div><Icon name="lucide:message-circle"/><span><strong>Clarity over jargon</strong><small>You know what’s happening and why.</small></span></div><div><Icon name="lucide:lock-keyhole"/><span><strong>Care with every change</strong><small>Security and continuity come first.</small></span></div><div><Icon name="lucide:route"/><span><strong>Built for the long run</strong><small>Fix the cause. Simplify what comes next.</small></span></div></article>
        </div>
      </section>
      <section class="section" aria-labelledby="expertise-title"><div class="section-heading"><div><p class="eyebrow">THE RIGHT EXPERTISE, RIGHT WHERE YOU NEED IT</p><h2 id="expertise-title">Your everyday IT.<br/><span>In capable hands.</span></h2></div><a class="text-link" href="/services/remote-it-support">Explore remote IT support <Icon name="lucide:arrow-up-right"/></a></div><div class="services">
        {[{icon:'cloud',title:'A cloud that works together',text:'Microsoft 365 and Google Workspace administration, setup, and migration.',href:'/services/workspace-management',label:'Cloud & workspace'},{icon:'mail-check',title:'Email with a clear path',text:'Mailbox migrations, DNS configuration, and email deliverability troubleshooting.',href:'/services/email-deliverability',label:'Email & deliverability'},{icon:'workflow',title:'Less busywork. More progress.',text:'Connected workflows and practical automation that give your team time back.',href:'/services/business-automation',label:'Automation & workflows'}].map(service=><a class="glass service" href={service.href}><div class="card-top"><span class="icon-tile"><Icon name={`lucide:${service.icon}`}/></span><Icon name="lucide:arrow-up-right"/></div><p class="eyebrow">{service.label}</p><h3>{service.title}</h3><p>{service.text}</p></a>)}
      </div><details class="skill-details glass"><summary>Explore the full technical toolkit <span aria-hidden="true">+</span></summary><div class="skills">{skills.map(skill=><span>{skill}</span>)}</div></details></section>
      <section id="specializations" class="section" aria-labelledby="specializations-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Deep Coverage</p>
            <h2 id="specializations-title">Our Niche <span>Specializations</span></h2>
          </div>
          <p>Different businesses. Different IT challenges.<br/>Support shaped around the way your industry works.</p>
        </div>
        <div class="industry-grid">
          {[
            { icon: 'megaphone', title: 'Marketing & Creative Agencies', description: 'Keep client projects moving with organized workspaces, reliable email, and smooth onboarding for distributed teams.', tags: ['Client collaboration', 'Email deliverability'] },
            { icon: 'scale', title: 'Law Firms', description: 'Manage access to sensitive documents, simplify mailbox migrations, and keep communication organized across your practice.', tags: ['Access management', 'Secure collaboration'] },
            { icon: 'heart-pulse', title: 'Healthcare Practices', description: 'Support the people behind patient care with carefully managed accounts, secure workspace settings, and dependable everyday IT.', tags: ['Account security', 'Staff IT support'] },
            { icon: 'shopping-bag', title: 'E-commerce Businesses', description: 'Connect your business tools, troubleshoot email delivery, and automate repetitive tasks so your team can focus on customers.', tags: ['Workflow automation', 'Business email'] },
            { icon: 'blocks', title: 'SaaS & Technology Companies', description: 'Build a more manageable IT foundation with cloud administration, onboarding workflows, and support for a growing remote team.', tags: ['Cloud administration', 'Team onboarding'] },
            { icon: 'heart-pulse', title: 'Dental Clinics', description: 'Keep front-desk teams connected with reliable business email, managed staff accounts, and remote support for everyday IT issues.', tags: ['Front-desk IT', 'Staff account management'] },
            { icon: 'droplets', title: 'Carpet Cleaning', description: 'Keep customer inquiries organized and connect office and field teams with shared calendars, business email, and practical workflow automation.', tags: ['Customer inquiries', 'Shared calendars'] },
            { icon: 'sparkles', title: 'Cleaning Companies', description: 'Simplify communication across cleaning crews with organized shared files, staff onboarding, and connected business tools.', tags: ['Team communication', 'Staff onboarding'] },
            { icon: 'truck', title: 'Moving Companies', description: 'Help office and moving crews stay coordinated with shared schedules, accessible job documents, and dependable business email.', tags: ['Crew coordination', 'Document access'] },
            { icon: 'wrench', title: 'Restoration', description: 'Support time-sensitive projects with organized project files, secure team access, and reliable communication between office and field staff.', tags: ['Project collaboration', 'Secure file sharing'] },
            { icon: 'house', title: 'Roofing', description: 'Keep estimates, project documents, and team communication organized with managed cloud workspaces and support for office and field teams.', tags: ['Cloud workspaces', 'Project documents'] },
            { icon: 'bug', title: 'Pest Control', description: 'Connect technicians and office staff through shared schedules, reliable email, and automation for routine administrative tasks.', tags: ['Technician coordination', 'Workflow automation'] },
            { icon: 'activity', title: 'Chiropractors', description: 'Reduce everyday IT friction with managed staff accounts, secure collaboration tools, and remote troubleshooting for your practice.', tags: ['Practice IT support', 'Access management'] },
            { icon: 'flower-2', title: 'Medspas', description: 'Support your front desk and growing team with dependable email, organized cloud tools, and careful account onboarding and offboarding.', tags: ['Business email', 'Team access'] },
          ].map((industry, index) => (
            <article class="glass industry-card">
              <div class="card-top">
                <span class="icon-tile"><Icon name={`lucide:${industry.icon}`} /></span>
                <span class="industry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3>{industry.title}</h3>
              <p>{industry.description}</p>
              <ul class="industry-tags" aria-label={`${industry.title} focus areas`}>
                {industry.tags.map(tag => <li>{tag}</li>)}
              </ul>
            </article>
          ))}
          <div class="glass industry-card industry-invitation">
            <span class="icon-tile"><Icon name="lucide:messages-square" /></span>
            <h3>Your industry.<br/>Your specific challenges.</h3>
            <p>Do not see your business here? Tell us how you work and where IT gets in the way.</p>
            <a class="text-link" href="/contact">Find the right support <Icon name="lucide:arrow-up-right" /></a>
          </div>
        </div>
      </section>
      <section class="section credentials" aria-labelledby="credentials-title"><div class="section-heading"><div><p class="eyebrow">EXPERIENCE YOU CAN CHECK</p><h2 id="credentials-title">Built on practice.<br/><span>Backed by learning.</span></h2></div><p>Hands-on experience and continued learning<br/>across cloud, security, and infrastructure.</p></div>
        <div class="education glass"><span class="icon-tile"><Icon name="lucide:graduation-cap"/></span><div><p class="eyebrow">EDUCATION</p>{education.map(edu=><><h3>{edu.degree}</h3><p>{edu.institution} · {edu.year}</p></>)}</div></div>
        <div class="cert-grid">{certifications.map((cert,index)=><article class="glass cert"><span class="cert-issuer"><Icon name="lucide:badge-check"/>{cert.issuer}</span><h3>{cert.title}</h3><div class="cert-actions"><a href={cert.verifyLink} target="_blank" rel="noopener noreferrer">Verify credential <span aria-hidden="true">↗</span></a><button type="button" data-cert-open={`cert-dialog-${index}`}>View certificate</button></div><dialog id={`cert-dialog-${index}`} aria-labelledby={`cert-title-${index}`}><div class="dialog-content"><form method="dialog"><button aria-label="Close certificate" class="close-button">×</button></form><h3 id={`cert-title-${index}`}>{cert.title}</h3><p>{cert.issuer}</p><img src={cert.image} alt={`${cert.title} certificate`} loading="lazy"/></div></dialog></article>)}</div>
        <details class="career glass"><summary>Explore my professional journey <span aria-hidden="true">+</span></summary><ExperienceTimeline/></details>
      </section>
      <section class="glass final-cta" aria-labelledby="cta-title"><div><p class="eyebrow"><span class="status-dot"></span> YOUR NEXT CHAPTER STARTS WITH A CONVERSATION</p><h2 id="cta-title">Let’s make IT<br/><span>one less thing to worry about.</span></h2><p>A migration, a recurring issue, or a fresh start.<br/>Tell us what you need. We’ll help you find the way forward.</p></div><div class="cta-actions"><a href="/contact" class="button primary">Talk to your IT partner <Icon name="lucide:arrow-up-right"/></a><a href="mailto:hello@itsupportbee.com" class="text-link">hello@itsupportbee.com</a></div></section>
    </div>
  </div>
</BaseLayout>
<style>
  .industry-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .industry-card { padding: 28px; display: flex; flex-direction: column; transition: border-color .2s, transform .2s; }
  .industry-card:hover { border-color: #ac82f344; transform: translateY(-3px); }
  .industry-number { font-size: 12px; letter-spacing: .12em; color: #a091b6; }
  .industry-card h3 { font-size: 19px; margin-bottom: 13px; }
  .industry-card > p { font-size: 12px; line-height: 1.95; color: var(--muted); margin-bottom: 24px; }
  .industry-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; list-style: none; padding: 0; }
  .industry-tags li { font-size: 9px; padding: 6px 10px; border: 1px solid #ffffff12; background: #ffffff03; border-radius: 7px; color: #c9beda; }
  .industry-invitation { background: radial-gradient(ellipse at top right, #2d058a66, transparent 80%), linear-gradient(135deg, #90ee0209, #ffffff02); border-color: #90ee0226; }
  .industry-invitation > .icon-tile { color: var(--lime); margin-bottom: 28px; }
  .industry-invitation > .text-link { color: var(--lime); margin-top: auto; min-height: 44px; }
  @media (max-width: 1000px) { .industry-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .industry-grid { grid-template-columns: 1fr; } .industry-card { padding: 25px; } }
  .about{--purple:#2d058a;--lime:#90ee02;--muted:#b4adc7;background:#0d071b;color:#f7f5fc;position:relative;overflow:hidden;background-image:radial-gradient(ellipse at 75% 6%,#2d058a55,transparent 26%),radial-gradient(ellipse at 0% 38%,#2d058a24,transparent 25%)}
  .shell{max-width:1240px;padding:80px 32px 88px;margin:auto;position:relative}.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:76px;align-items:center;padding:30px 0 72px}.eyebrow{font-size:10px;font-weight:700;letter-spacing:.18em;color:#c3b0ed;display:flex;align-items:center;gap:9px;line-height:1.7;text-transform:uppercase}.status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 15px #90ee0277;flex-shrink:0}h1{font-size:clamp(44px,5.1vw,67px);line-height:1.12;letter-spacing:-.055em;font-weight:700;margin:24px 0}h1>span{color:var(--lime)}.intro{font-size:21px;line-height:1.65;color:#e0d9ef}.hero-description{font-size:14px;color:var(--muted);max-width:470px;margin:18px 0 28px;line-height:1.9}.actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:16px 22px;border-radius:12px;font-size:12px;font-weight:700;transition:transform .2s,box-shadow .2s}.primary{background:var(--lime);color:#22065c;box-shadow:0 5px 30px #90ee0215}.button:hover{transform:translateY(-3px);box-shadow:0 8px 32px #90ee0233}.text-link{display:inline-flex;gap:10px;align-items:center;font-size:12px;font-weight:500;color:#eee7fc}.text-link:hover{color:var(--lime)}[data-icon]{width:20px;height:20px;flex-shrink:0}.hero-notes{display:flex;flex-wrap:wrap;gap:22px;margin-top:27px;color:#a69cb9;font-size:11px}.hero-notes span{display:flex;align-items:center;gap:7px}.hero-notes [data-icon]{width:14px;height:14px}.glass{border:1px solid #ffffff14;background:linear-gradient(135deg,#ffffff08,#ffffff02);border-radius:22px;box-shadow:inset 0 1px 0 #ffffff05;backdrop-filter:blur(16px)}.hero-visual{position:relative;padding:0 22px 0 10px}.portrait{height:490px;position:relative;overflow:hidden;transform:rotate(2deg);border-color:#ffffff24}.portrait img{width:100%;height:100%;object-fit:cover;object-position:center 25%}.portrait-shade{position:absolute;inset:0;b