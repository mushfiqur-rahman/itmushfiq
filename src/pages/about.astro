---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';


const education = [
  {
    degree: "Bachelor of Science (B.Sc) in Computer Science & Engineering",
    institution: "National University, Bangladesh",
    year: "Graduated"
  }
];

const certifications = [
  {
    title: "AI Fundamental",
    issuer: "Google",
    image: "/certificates/AI Fundamental-BNHMV1XP27XX.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/BNHMV1XP27XX" 
  },
  {
    title: "HIPAA Fundamentals",
    issuer: "SkillUp",
    image: "/certificates/HIPAA Fundamentals.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/7RJAGDYQMH5P"
  },
  {
    title: "Introduction to Microsoft Azure Cloud Services",
    issuer: "Microsoft",
    image: "/certificates/Introduction to Microsoft Azure Cloud Services.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/WL9TYX2YBI8D"
  },
  {
    title: "MS-102: Microsoft 365 Administrator",
    issuer: "Packt",
    image: "/certificates/Microsoft 365 Administrator.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/VA55I5HN6LC6"
  },
  {
    title: "Google Workspace Administrator",
    issuer: "Google Cloud",
    image: "/certificates/Google Workspace Administrator.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/specialization/LTH01Q01M3ND"
  },
  {
    title: "Foundations of Cybersecurity",
    issuer: "Google",
    image: "/certificates/Foundations of Cybersecurity.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/PWZ8ZGLJFVHQ"
  },
  {
    title: "Planning for a Google Workspace Deployment",
    issuer: "Google Cloud",
    image: "/certificates/Planning for a Google Workspace Deployment.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/XYWXS11GKC9V"
  },
  {
    title: "Fundamentals of Red Hat Enterprise Linux",
    issuer: "Red Hat",
    image: "/certificates/Fundamentals of Red Hat Enterprise Linux.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/YAA9RMASNSNJ"
  },
  {
    title: "Introduction to Computers",
    issuer: "Microsoft",
    image: "/certificates/Introduction to Computers.png",
    verifyLink: "https://www.coursera.org/account/accomplishments/verify/326FIAT22LFB"
  },
  {
    title: "IELTS",
    issuer: "British Council",
    image: "/certificates/IELTS.png",
    verifyLink: "https://ielts.org/organisations/ielts-for-organisations/verifying-ielts-results"
  }
];

const skills = ["Microsoft 365", "Google Workspace", "Email Deliverability", "DNS Security", "Astro", "Tailwind CSS", "WordPress", "Zapier & n8n", "Linux Server Admin", "Bash Scripting"];
---

<BaseLayout title="About Me | IT Mushfiq - Infrastructure Expert">
  
  <div class="bg-white dark:bg-[#0f0224] pt-24 pb-16 overflow-hidden">
    <div class="max-w-360 mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- 1. Who Am I (Hero Section) -->
      <section class="mb-24 relative">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 text-sm font-bold tracking-widest uppercase border-2 border-[#2D058A] text-[#2D058A] dark:border-[#90ee02] dark:text-[#90ee02] rounded-full">
              Who I Am
            </div>
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-[#2D058A] dark:text-white tracking-tighter mb-8 leading-[1.1]">
              Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:from-[#90ee02] dark:to-[#ccff66]">Mushfiq.</span>
            </h1>
            <div class="space-y-6 text-xl text-slate-700 dark:text-slate-300 font-medium leading-relaxed">
              <p>
                I am a remote IT Support Engineer and Cloud Administrator with over three years of proven experience in transforming messy infrastructures into streamlined, secure, and automated systems.
              </p>
              <p>
                As the founder of IT Support Bee, my mission is simple: eliminate IT downtime, ensure your business emails actually reach the inbox, and automate repetitive workflows so you can focus on scaling your business. I don't just fix problems; I architect long-term solutions.
              </p>
            </div>
          </div>
          
          <div class="relative w-full aspect-square max-w-md mx-auto lg:ml-auto">
            <div class="absolute inset-0 bg-[#90ee02] translate-x-4 translate-y-4 rounded-2xl border-4 border-[#2D058A] dark:border-[#90ee02]"></div>
            <div class="absolute inset-0 bg-[#2D058A] overflow-hidden rounded-2xl border-4 border-[#2D058A] dark:border-[#90ee02] z-10 grayscale hover:grayscale-0 transition-all duration-500">
              <img src="/mushfiqur.jpg" alt="Mushfiqur Rahman" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/600x600/2D058A/90ee02?text=MUSHFIQUR'"/>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Technical Arsenal -->
      <section class="mb-32">
        <h2 class="text-2xl font-black text-[#2D058A] dark:text-white uppercase tracking-widest mb-8 border-b-4 border-[#2D058A] dark:border-white/10 pb-4 inline-block">
          Technical Arsenal
        </h2>
        <div class="flex flex-wrap gap-4">
          {skills.map((skill) => (
            <span class="px-6 py-3 text-lg font-bold text-[#2D058A] dark:text-white bg-slate-100 dark:bg-[#150734] border-2 border-[#2D058A] dark:border-white/20 shadow-[4px_4px_0px_0px_rgba(45,5,138,1)] dark:shadow-[4px_4px_0px_0px_rgba(144,238,2,0.4)] rounded-xl hover:-translate-y-1 transition-transform">
              {skill}
            </span>
          ))}
        </div>
      </section>
<ExperienceTimeline/>
      <!-- 3. Experience & Education Row -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 mb-24">      
       
        

        <!-- Education -->
        <section class="lg:col-span-8">
          <h2 class="text-3xl font-black text-[#2D058A] dark:text-white tracking-tighter mb-8">
            Education.
          </h2>
          <div class="space-y-6">
            {education.map((edu) => (
              <div class="p-6 bg-slate-50 dark:bg-[#150734] border-2 border-slate-200 dark:border-white/10 rounded-2xl">
                <h3 class="text-xl font-bold text-[#2D058A] dark:text-white mb-2">{edu.degree}</h3>
                <p class="text-slate-600 dark:text-slate-400 font-medium mb-4">{edu.institution}</p>
                <span class="text-sm font-bold px-3 py-1 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md">
                  {edu.year}
                </span>
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- 4. Certifications Section (Below Experience) -->
      <section class="border-t border-[#2D058A]/10 dark:border-white/10 pt-24">
        <div class="mb-12">
          <h2 class="text-4xl md:text-5xl font-black text-[#2D058A] dark:text-white tracking-tighter mb-4">
            Certifications & Licenses.
          </h2>
          <p class="text-xl text-slate-700 dark:text-slate-300 font-medium">Verified credentials proving my expertise in cloud administration and security.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {certifications.map((cert, index) => (
            <div class="flex flex-col h-full bg-white dark:bg-[#150734] border-2 border-[#2D058A] dark:border-white/20 rounded-2xl shadow-[4px_4px_0px_0px_rgba(45,5,138,1)] dark:shadow-[4px_4px_0px_0px_rgba(144,238,2,0.3)] hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_rgba(45,5,138,1)] dark:hover:shadow-[6px_6px_0px_0px_rgba(144,238,2,0.6)] transition-all duration-300 p-6 md:p-8">
              
              <div class="flex items-start gap-4 mb-8">
                <div class="w-12 h-12 shrink-0 bg-[#90ee02] border-2 border-[#2D058A] flex items-center justify-center rounded-lg mt-1">
                  <svg class="w-6 h-6 text-[#2D058A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-xl text-[#2D058A] dark:text-white leading-tight mb-2">
                    {cert.title}
                  </h3>
                  <p class="text-base font-medium text-slate-500 dark:text-slate-400">
                    Issued by: <span class="font-bold text-slate-700 dark:text-slate-300">{cert.issuer}</span>
                  </p>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="mt-auto flex flex-wrap gap-4 pt-6 border-t border-[#2D058A]/10 dark:border-white/10">
                <!-- Verify Button -->
                {cert.verifyLink && cert.verifyLink !== "#" && (
                  <a 
                    href={cert.verifyLink} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#2D058A] dark:bg-[#90ee02] text-white dark:text-[#2D058A] font-bold text-sm uppercase tracking-wider rounded-lg border-2 border-[#2D058A] dark:border-[#90ee02] hover:-translate-y-1 shadow-[2px_2px_0px_0px_rgba(144,238,2,1)] dark:shadow-[2px_2px_0px_0px_rgba(255,255,255,0.4)] transition-all"
                  >
                    Verify Credential
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                  </a>
                )}
                
                <!-- View Image Button (Lightbox Trigger) -->
                <button 
                  onclick={`document.getElementById('cert-dialog-${index}').showModal()`}
                  class="inline-flex items-center gap-2 px-5 py-2.5 dark:hover:text-slate-500 bg-white dark:bg-transparent text-[#2D058A] dark:text-white font-bold text-sm uppercase tracking-wider rounded-lg border-2 border-[#2D058A] dark:border-white/30 hover:bg-slate-50 dark:hover:border-[#90ee02] transition-colors cursor-pointer"
                >
                  View Certificate
                </button>
              </div>

              <!-- Native HTML Lightbox Dialog -->
              <dialog 
                id={`cert-dialog-${index}`} 
                class="bg-transparent backdrop:bg-[#0f0224]/80 backdrop:backdrop-blur-sm p-4 m-auto max-w-4xl w-full"
              >
                <div class="bg-white dark:bg-[#150734] p-3 border-4 border-[#2D058A] dark:border-[#90ee02] shadow-[8px_8px_0px_0px_rgba(45,5,138,1)] dark:shadow-[8px_8px_0px_0px_rgba(144,238,2,0.4)] rounded-2xl relative flex flex-col">
                  <button 
                    onclick={`document.getElementById('cert-dialog-${index}').close()`}
                    class="absolute -top-4 -right-4 w-10 h-10 bg-[#90ee02] dark:bg-[#2D058A] text-[#2D058A] dark:text-[#90ee02] border-2 border-[#2D058A] dark:border-[#90ee02] rounded-full font-black text-2xl flex items-center justify-center shadow-[2px_2px_0px_0px_rgba(45,5,138,1)] hover:scale-110 transition-transform z-10 cursor-pointer"
                    aria-label="Close dialog"
                  >
                    &times;
                  </button>
                  
                  <div class="overflow-hidden rounded-xl border-2 border-slate-200 dark:border-white/10 mb-4 bg-slate-100 dark:bg-[#0f0224] flex items-center justify-center p-2">
                    <img 
                      src={cert.image} 
                      alt={`${cert.title} Certificate`} 
                      class="w-full h-auto max-h-[75vh] object-contain"
                      loading="lazy"
                      onerror="this.src='https://placehold.co/800x600/f8fafc/2D058A?text=Certificate+Image+Pending'"
                    />
                  </div>

                  <div class="text-center px-4 pb-2">
                    <h4 class="font-bold text-lg text-[#2D058A] dark:text-white mb-1">{cert.title}</h4>
                    <p class="text-sm font-medium text-slate-500">{cert.issuer}</p>
                  </div>
                </div>
              </dialog>

            </div>
          ))}
        </div>
      </section>

    </div>
  </div>
</BaseLayout>