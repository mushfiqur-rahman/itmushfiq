---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { bookingUrl } from '../data/booking';
const socials = [{name:'LinkedIn',url:'https://www.linkedin.com/in/itmushfiq/',icon:'linkedin'},{name:'Facebook',url:'https://facebook.com/itsupportbee',icon:'facebook'},{name:'X / Twitter',url:'https://x.com/itsupportbee',icon:'twitter'},{name:'Instagram',url:'https://instagram.com/itsupportbee',icon:'instagram'},{name:'TikTok',url:'https://tiktok.com/@itsupportbee',icon:'music-2'}];
---
<BaseLayout title="Get Business Email & IT Help | IT Support Bee" description="Discuss an email migration, spam problem, Microsoft 365 or Google Workspace setup, or ongoing IT support. Contact IT Support Bee for a scoped plan.">
<section class="contact" aria-labelledby="contact-title">
<div class="shell">
<header class="intro">
<p class="eyebrow"><span></span> GOOD IT STARTS WITH A CONVERSATION</p>
<h1 id="contact-title">Big plans. Small questions.<br/><span>Let us talk IT.</span></h1>
<p>Email going to spam, a move to a new provider, or ongoing IT support?<br/>Tell us about your setup and what you need to change.</p>
<div class="benefits"><span><Icon name="lucide:globe"/> Remote-first support</span><span><Icon name="lucide:shield-check"/> People you can rely on</span></div>
</header>
<div class="bento">
<div class="channels">
<a href={bookingUrl} class="glass chat booking-card">
<div class="card-top"><span class="tile"><Icon name="lucide:calendar"/></span><span class="kicker">BOOK A CONSULTATION</span><Icon name="lucide:arrow-up-right"/></div>
<h2>Your next IT move.<br/><span>Let us map it out.</span></h2>
<p>Discuss your remote IT support needs. View available times and complete your booking on Calendly.</p>
<div class="meeting-visual" aria-hidden="true"><div class="meeting-line"><span class="meeting-dot"></span> A conversation with IT Support Bee</div><div class="meeting-agenda"><span>YOUR CHALLENGE</span><span class="agenda-arrow">→</span><span>A CLEAR NEXT STEP</span></div><div class="meeting-bottom"><Icon name="lucide:video"/> Connect from wherever you work.</div></div>
<span class="action">Choose a time <Icon name="lucide:arrow-up-right" aria-hidden="true"/></span><span class="booking-note">View availability and book on Calendly</span>
</a>
<a href="https://wa.me/447988585324" class="glass chat whatsapp-card">
<div class="card-top"><span class="tile"><Icon name="lucide:message-circle"/></span><span class="kicker">LET’S TALK</span><Icon name="lucide:arrow-up-right"/></div>
<h2>A real person.<br/>A clearer way forward.</h2><p>Skip the ticket queue. Start a conversation<br/>with our team on WhatsApp.</p><span class="action">Chat with an IT expert <Icon name="lucide:arrow-right"/></span><div class="orbit" aria-hidden="true"></div>
</a>
<div class="direct">
<a class="glass mini" href="mailto:hello@itsupportbee.com"><Icon name="lucide:mail"/><h2>Prefer email?</h2><p>Give us the bigger picture.</p><span>hello@itsupportbee.com ↗</span></a>
<a class="glass mini" href="tel:+447988585324"><Icon name="lucide:phone"/><h2>Let’s talk it through.</h2><p>Sometimes a call is easier.</p><span>+44 7988 585324 ↗</span></a>
</div>
<section class="glass next" aria-labelledby="next-title"><p class="kicker">GOOD TO KNOW</p><h2 id="next-title">What happens next?</h2><ol>
<li><span>01</span><div><h3>We listen first.</h3><p>We get to know your business and the challenge.</p></div></li>
<li><span>02</span><div><h3>You get a clear plan.</h3><p>Practical next steps, explained without the jargon.</p></div></li>
<li><span>03</span><div><h3>We make IT work for you.</h3><p>Move forward with support that fits your team.</p></div></li>
</ol></section>
</div>

</div>
<section class="locations" aria-labelledby="locations-title"><div class="location-intro"><p class="kicker">LOCAL ROOTS. GLOBAL REACH.</p><h2 id="locations-title">Near or far,<br/>we’re on your team.</h2><p>Based in Bangladesh and the UK.<br/>Connected to your business, wherever you work.</p></div>
<a class="glass office" href="https://maps.app.goo.gl/xMpanDiXEeTepe7D8" target="_blank" rel="noopener noreferrer"><div class="office-top">BD / 01 <Icon name="lucide:arrow-up-right"/></div><Icon name="lucide:map-pin"/><h3>Jashore, Bangladesh</h3><p>Software Technology Park<br/>Jashore, Bangladesh</p><span>View on Google Maps <span class="sr-only">(opens in a new tab)</span></span></a>
<a class="glass office" href="https://maps.app.goo.gl/chnU3DmxJvgfsiRs6" target="_blank" rel="noopener noreferrer"><div class="office-top">UK / 02 <Icon name="lucide:arrow-up-right"/></div><Icon name="lucide:map-pin"/><h3>London, United Kingdom</h3><p>9 New Change<br/>London EC4M 9AG, UK</p><span>View on Google Maps <span class="sr-only">(opens in a new tab)</span></span></a>
</section>
<div class="socials"><p>Good connections start with a hello.</p><nav aria-label="Social media">{socials.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} (opens in a new tab)`}><Icon name={`lucide:${s.icon}`}/></a>)}</nav></div>
</div>
</section>
</BaseLayout>

<style>
.contact{--muted:#bbb2cd;--line:#c7afff24;background:radial-gradient(ellipse 650px 470px at 50% 0,#2d058a70,transparent),radial-gradient(ellipse 400px 700px at 100% 55%,#46218425,transparent),#0c071b;color:#f6f2ff;padding:150px 24px 65px;overflow:hidden}.shell{max-width:1180px;margin:auto}.intro{text-align:center;margin-bottom:52px}.eyebrow{display:inline-flex;align-items:center;gap:9px;border:1px solid var(--line);border-radius:30px;padding:8px 15px;font-size:9px;letter-spacing:.18em;color:#d6c5f7;background:#ffffff04}.eyebrow span{width:6px;height:6px;background:#c5a4ff;border-radius:50%;box-shadow:0 0 14px #bc94ff}h1{font-size:clamp(40px,5.4vw,70px);font-weight:500;letter-spacing:-.055em;line-height:1.12;margin:24px 0 22px}h1 span{background:linear-gradient(100deg,#f0e5ff,#ae8bdc);background-clip:text;color:transparent}.intro>p:not(.eyebrow){font-size:14px;color:var(--muted);line-height:1.9}.benefits{display:flex;justify-content:center;gap:25px;margin-top:22px;font-size:11px;color:#d1c6e3}.benefits span{display:flex;align-items:center;gap:7px}.benefits svg{width:14px;height:14px;color:#c09bf7}.bento{display:grid;grid-template-columns:1fr 1.13fr;gap:22px;align-items:start}.channels{display:grid;gap:18px}.glass{border:1px solid var(--line);border-radius:22px;background:linear-gradient(130deg,#ffffff0d,#ffffff04);box-shadow:inset 0 1px 0 #ffffff05,0 12px 40px #0000000a;backdrop-filter:blur(18px)}a.glass{display:block;transition:transform .2s,border-color .2s}a.glass:hover{border-color:#ab8ad575;transform:translateY(-3px)}.chat{position:relative;overflow:hidden;padding:27px 28px;background:radial-gradient(ellipse at 100% 0,#754dc640,transparent 65%),linear-gradient(125deg,#2d058a99,#231337)}.card-top{display:flex;align-items:center;gap:12px;margin-bottom:24px}.tile{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;border:1px solid #ffffff20;background:#ffffff12}.tile svg{width:22px;height:22px}.kicker{font-size:9px;font-weight:500;letter-spacing:.17em;color:#cbb7eb}.card-top>svg{margin-left:auto;width:20px;height:20px;color:#c7afed}.chat h2{font-size:27px;line-height:1.3;letter-spacing:-.035em;font-weight:500;position:relative;z-index:1}.chat p{font-size:12px;color:#d1c2e6;margin-top:13px}.action{display:flex;align-items:center;gap:13px;font-size:12px;font-weight:500;margin-top:26px}.action svg{width:17px;height:17px}.orbit{position:absolute;width:220px;height:220px;border:1px solid #bb99ff25;border-radius:50%;right:-100px;bottom:-120px;box-shadow:0 0 0 30px #aa88ff09,0 0 0 60px #aa88ff06;pointer-events:none}.direct{display:grid;grid-template-columns:1fr 1fr;gap:18px}.mini{padding:22px 19px;min-width:0}.mini>svg{width:20px;height:20px;color:#c3a0fa;margin-bottom:19px}.mini h2{font-size:13px;font-weight:500}.mini p{font-size:10px;color:var(--muted);margin:5px 0 13px}.mini>span{font-size:10px;color:#d8c7f7;overflow-wrap:anywhere}.next{padding:24px 28px}.next h2{font-size:19px;margin-top:7px;letter-spacing:-.03em}ol{display:grid;gap:16px;margin-top:21px}li{display:flex;gap:14px}li>span{display:grid;place-items:center;width:28px;height:28px;flex-shrink:0;border:1px solid var(--line);border-radius:50%;font-size:10px;color:#bca4de}li h3{font-weight:500;font-size:12px}li p{font-size:10px;color:var(--muted);margin-top:2px}.locations{display:grid;grid-template-columns:1fr 1fr 1fr;gap:22px;margin-top:52px}.location-intro{padding:14px 0}.location-intro h2{font-size:26px;line-height:1.35;letter-spacing:-.035em;margin:14px 0}.location-intro>p:last-child{font-size:11px;color:var(--muted)}.office{padding:23px}.office-top{display:flex;justify-content:space-between;color:#baa7d3;font-size:9px;letter-spacing:.15em}.office-top svg{width:16px;height:16px}.office>svg{width:22px;height:22px;color:#c4a5f5;margin:20px 0 12px}.office h3{font-size:14px;font-weight:500;letter-spacing:-.02em}.office p{font-size:11px;color:var(--muted);margin:8px 0 15px}.office>span{font-size:10px;color:#d3b8fc}.socials{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:27px;margin-top:35px}.socials p{font-size:11px;color:var(--muted)}.socials nav{display:flex;gap:8px}.socials a{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--line);border-radius:50%;color:#c5b4dd}.socials a:hover{background:#2d058a}.socials svg{width:16px;height:16px}.contact :is(a,button,input,select,textarea):focus-visible{outline:3px solid #c7a6ff;outline-offset:4px}
/* Direct contact hub: no form, submission handler, or client-side state. */
.contact { padding-top: 140px; }
.intro { margin-bottom: 40px; }
.eyebrow { font-size: .75rem; letter-spacing: .1em; }
.intro>p:not(.eyebrow) { font-size: 1rem; }
.benefits { font-size: .875rem; flex-wrap: wrap; }
.bento { display: block; }
.channels { grid-template-columns: 1fr 1.1fr; gap: 20px; }
.booking-card { grid-row: span 2; background: linear-gradient(140deg,#2d058a,#241341 72%); padding: 32px; }
.booking-card h2 { font-size: clamp(1.8rem,3vw,2.5rem); }
.booking-card h2 span { color: #ddc9ff; }
.chat p { font-size: 1rem; line-height: 1.75; }
.kicker { font-size: .75rem; letter-spacing: .08em; }
.meeting-visual { margin: 28px 0; padding: 20px; border: 1px solid #d4b9ff29; border-radius: 14px; background: #140b2d; transform: rotate(-1deg); }
.meeting-line { display: flex; align-items: center; gap: 8px; font-size: .875rem; color: #e0d7ed; }
.meeting-dot { width: 7px; height: 7px; border-radius: 50%; background: #90ee02; flex-shrink: 0; }
.meeting-agenda { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 20px 0; font-size: .75rem; letter-spacing: .04em; color: #d6c6ec; }
.agenda-arrow { color: #90ee02; font-size: 1.25rem; }
.meeting-bottom { display: flex; align-items: center; gap: 8px; font-size: .875rem; color: #c8bdd8; border-top: 1px solid #ffffff15; padding-top: 12px; }
.meeting-bottom svg { width: 16px; height: 16px; flex-shrink: 0; }
.action { font-size: 1rem; }
.booking-card .action { justify-content: space-between; padding: 13px 18px; min-height: 50px; border-radius: 10px; background: #90ee02; color: #2d058a; font-weight: 700; }
.booking-note { display: block; margin-top: 12px; text-align: center; font-size: .875rem; color: #d3c7e5; }
.whatsapp-card { background: radial-gradient(ellipse at 100% 0,#90ee020b,transparent 70%),#151422; }
.whatsapp-card .tile,.whatsapp-card .action { color: #90ee02; }
.direct { gap: 18px; }
.mini { padding: 24px 20px; }
.mini h2 { font-size: 1.125rem; }
.mini p { font-size: .9375rem; line-height: 1.7; }
.mini>span { font-size: .875rem; }
.next { grid-column: 1/-1; background: transparent; border-width: 1px 0; border-radius: 0; box-shadow: none; padding: 28px 0; margin-top: 10px; }
.next h2 { font-size: 1.5rem; }
ol { grid-template-columns: repeat(3,1fr); gap: 24px; }
li>span { font-size: .875rem; width: 32px; height: 32px; }
li h3 { font-size: 1rem; }
li p { font-size: .9375rem; line-height: 1.7; }
.locations { margin-top: 32px; }
.location-intro>p:last-child,.office p { font-size: .9375rem; }
.office-top { font-size: .75rem; }
.office h3 { font-size: 1rem; }
.office>span,.socials p { font-size: .875rem; }
.contact a:focus-visible { outline: 3px solid #90ee02; outline-offset: 5px; }
@media(max-width:1000px) { .direct { grid-template-columns: 1fr; } .locations { grid-template-columns: 1fr 1fr; } .location-intro { grid-column: 1/-1; } }
@media(max-width:700px) { .contact { padding: 120px 20px 40px; } .intro { margin-bottom: 30px; } .eyebrow { font-size: .6875rem; letter-spacing: .06em; } .channels { grid-template-columns: 1fr; } .booking-card { grid-row: auto; padding: 24px; } .chat { padding: 24px; } .meeting-visual { transform: none; } .direct { grid-template-columns: 1fr 1fr; } .mini { padding: 22px 18px; } .locations { gap: 14px; } .office { padding: 20px; } .socials { flex-direction: column; align-items: flex-start; gap: 16px; } ol { grid-template-columns: 1fr; } }
@media(max-width:480px) { .direct,.locations { grid-template-columns: 1fr; } }
@media(prefers-reduced-motion:reduce) { a.glass { transition: none; } a.glass:hover { transform: none; } }
@media(forced-colors:active) { .glass,.booking-card .action,.meeting-visual { border: 1px solid CanvasText; } .contact a:focus-visible { outline-color: Highlight; } }
</style>

