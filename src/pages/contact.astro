---
import BaseLayout from "../layouts/BaseLayout.astro";

const socialLinks = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/company/itsupportbee",
    icon: "in",
  },
  { name: "Facebook", url: "https://www.facebook.com/itsupportbee", icon: "f" },
  { name: "X (Twitter)", url: "https://x.com/itsupportbee", icon: "𝕏" },
  { name: "YouTube", url: "https://www.youtube.com/@itsupportbee", icon: "▶" },
  {
    name: "Instagram",
    url: "https://www.instagram.com/itsupportbee",
    icon: "ig",
  },
  { name: "TikTok", url: "https://www.tiktok.com/@itsupportbee", icon: "tk" },
];

const services = [
  "Google Workspace Migration",
  "Microsoft 365 Setup",
  "Email Deliverability (SPF/DKIM/DMARC)",
  "Web Development (Astro/WordPress)",
  "IT Infrastructure Support",
];
---

<BaseLayout title="Contact Us | IT Support Bee">
  <div class="bg-slate-50 dark:bg-[#0f0224] pt-32 pb-32 min-h-screen">
    <div class="max-w-360 mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Left Column: Contact Information -->
        <div class="space-y-12">
          <header>
            <h1
              class="text-5xl md:text-6xl font-black text-[#2D058A] dark:text-white tracking-tighter mb-4 leading-[1.1]"
            >
              Pick the Channel <br /><span
                class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:from-[#90ee02] dark:to-[#ccff66]"
                >That Suits You.</span
              >
            </h1>
          </header>

          <!-- Contact Methods -->
          <div
            class="bg-white dark:bg-[#150734] border-4 border-[#2D058A] dark:border-white/10 rounded-2xl p-6 md:p-8 shadow-[8px_8px_0px_0px_rgba(45,5,138,1)] dark:shadow-[8px_8px_0px_0px_rgba(144,238,2,0.3)] space-y-8"
          >
            <!-- WhatsApp / Phone -->
            <div
              class="flex items-start gap-4 pb-8 border-b-2 border-slate-100 dark:border-white/10"
            >
              <div
                class="w-12 h-12 shrink-0 bg-[#90ee02] border-2 border-[#2D058A] flex items-center justify-center rounded-xl"
              >
                <svg
                  class="w-6 h-6 text-[#2D058A]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path></svg
                >
              </div>
              <div>
                <h3
                  class="font-bold text-lg text-slate-900 dark:text-white mb-1"
                >
                  WhatsApp & Phone (Fastest)
                </h3>
                <a
                  href="tel:+447988585324"
                  class="text-xl font-black text-[#2D058A] dark:text-[#90ee02] hover:underline"
                  >+44 7988 585324</a
                >
                <p
                  class="text-sm text-slate-500 dark:text-slate-400 mt-1 font-medium"
                >
                  Replies within ~1 hour
                </p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 shrink-0 bg-slate-100 dark:bg-[#0f0224] border-2 border-[#2D058A] dark:border-[#90ee02] flex items-center justify-center rounded-xl"
              >
                <svg
                  class="w-6 h-6 text-[#2D058A] dark:text-[#90ee02]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path></svg
                >
              </div>
              <div>
                <h3
                  class="font-bold text-lg text-slate-900 dark:text-white mb-1"
                >
                  Email
                </h3>
                <a
                  href="mailto:hello@itsupportbee.com"
                  class="text-xl font-black text-[#2D058A] dark:text-[#90ee02] hover:underline"
                  >hello@itsupportbee.com</a
                >
                <p
                  class="text-sm text-slate-500 dark:text-slate-400 mt-1 font-medium"
                >
                  Replies within ~2 hours
                </p>
              </div>
            </div>
          </div>

          <!-- Offices Section -->
          <div>
            <h2
              class="text-2xl font-black text-[#2D058A] dark:text-white mb-6 uppercase tracking-widest"
            >
              Offices
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Bangladesh Office -->
              <a
                href="https://maps.app.goo.gl/xMpanDiXEeTepe7D8"
                target="_blank"
                rel="noopener noreferrer"
                class="group block p-6 bg-white dark:bg-[#150734] border-4 border-slate-200 dark:border-white/10 rounded-2xl hover:border-[#2D058A] dark:hover:border-[#90ee02] transition-colors cursor-pointer"
              >
                <h3
                  class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-[#2D058A] dark:group-hover:text-[#90ee02]"
                >
                  Bangladesh
                </h3>
                <p
                  class="text-sm font-medium text-slate-600 dark:text-slate-400"
                >
                  Software Technology Park<br />Jashore, Bangladesh
                </p>
              </a>

              <!-- UK Office -->
              <a
                href="https://maps.app.goo.gl/chnU3DmxJvgfsiRs6"
                target="_blank"
                rel="noopener noreferrer"
                class="group block p-6 bg-white dark:bg-[#150734] border-4 border-slate-200 dark:border-white/10 rounded-2xl hover:border-[#2D058A] dark:hover:border-[#90ee02] transition-colors cursor-pointer"
              >
                <h3
                  class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-[#2D058A] dark:group-hover:text-[#90ee02]"
                >
                  London, UK
                </h3>
                <p
                  class="text-sm font-medium text-slate-600 dark:text-slate-400"
                >
                  9 New Change<br />London EC4M 9AG, UK
                </p>
              </a>
            </div>
          </div>

          <!-- Social Links -->
          <div>
            <div class="flex flex-wrap gap-4">
              {
                socialLinks.map((social) => (
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visit our ${social.name}`}
                    class="w-12 h-12 flex items-center justify-center bg-white dark:bg-transparent text-[#2D058A] dark:text-white border-2 border-[#2D058A] dark:border-white/30 rounded-full font-black text-lg hover:bg-[#90ee02] dark:hover:bg-[#90ee02] hover:text-[#2D058A] hover:border-[#2D058A] dark:hover:text-[#2D058A] transition-all"
                  >
                    {social.icon}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Right Column: Contact Form -->
        <div
          class="bg-white dark:bg-[#150734] border-4 border-[#2D058A] dark:border-white/10 rounded-3xl p-8 md:p-12 shadow-[12px_12px_0px_0px_rgba(45,5,138,1)] dark:shadow-[12px_12px_0px_0px_rgba(144,238,2,0.4)]"
        >
          <h2
            class="text-3xl md:text-4xl font-black text-[#2D058A] dark:text-white mb-8 tracking-tight"
          >
            Share Your Requirements
          </h2>

          <form class="space-y-6" onsubmit="event.preventDefault();">
            <div>
              <label
                for="name"
                class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2"
                >Full Name <span class="text-red-500">*</span></label
              >
              <input
                type="text"
                id="name"
                placeholder="Enter your full name"
                required
                class="w-full px-5 py-3 bg-slate-50 dark:bg-[#0f0224] border-2 border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:border-[#2D058A] dark:focus:border-[#90ee02] text-slate-900 dark:text-white transition-colors"
              />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label
                  for="phone"
                  class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2"
                  >Phone <span class="text-red-500">*</span></label
                >
                <input
                  type="tel"
                  id="phone"
                  placeholder="+1 (555) 000-0000"
                  required
                  class="w-full px-5 py-3 bg-slate-50 dark:bg-[#0f0224] border-2 border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:border-[#2D058A] dark:focus:border-[#90ee02] text-slate-900 dark:text-white transition-colors"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2"
                  >Email <span class="text-red-500">*</span></label
                >
                <input
                  type="email"
                  id="email"
                  placeholder="your@email.com"
                  required
                  class="w-full px-5 py-3 bg-slate-50 dark:bg-[#0f0224] border-2 border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:border-[#2D058A] dark:focus:border-[#90ee02] text-slate-900 dark:text-white transition-colors"
                />
              </div>
            </div>

            <div>
              <label
                for="website"
                class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2"
                >Website</label
              >
              <input
                type="url"
                id="website"
                placeholder="https://yourwebsite.com"
                class="w-full px-5 py-3 bg-slate-50 dark:bg-[#0f0224] border-2 border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:border-[#2D058A] dark:focus:border-[#90ee02] text-slate-900 dark:text-white transition-colors"
              />
            </div>

            <div>
              <label
                for="service"
                class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2"
                >Select Your Services <span class="text-red-500">*</span></label
              >
              <div class="relative">
                <select
                  id="service"
                  required
                  class="w-full px-5 py-3 bg-slate-50 dark:bg-[#0f0224] border-2 border-slate-300 dark:border-white/10 rounded-xl focus:outline-none focus:border-[#2D058A] dark:focus:border-[#90ee02] text-slate-900 dark:text-white appearance-none transition-colors"
                >
                  <option value="" disabled selected>Select a service...</option
                  >
                  {
                    services.map((service) => (
                      <option value={service}>{service}</option>
                    ))
                  }
                </select>
                <!-- Custom Dropdown Arrow -->
                <div
                  class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500"
                >
                  <svg
                    class="fill-current h-4 w-4"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    ><path
                      d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"
                    ></path></svg
                  >
                </div>
              </div>
            </div>

            <div class="pt-4">
              <button
                type="submit"
                class="w-full px-8 py-4 bg-[#2D058A] dark:bg-[#90ee02] text-white dark:text-[#2D058A] font-black text-lg uppercase tracking-widest rounded-xl border-4 border-[#2D058A] dark:border-[#90ee02] hover:-translate-y-1 shadow-[4px_4px_0px_0px_rgba(144,238,2,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)] transition-all cursor-pointer"
              >
                Submit Request
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
