            <div class="grid grid-cols-2 gap-3 p-4">
              <div class="rounded-xl border border-white/10 bg-white/5 p-3.5"><p class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Resolved today</p><p class="mt-1 text-2xl font-semibold text-white">38 <span class="text-sm text-slate-400">tickets</span></p></div>
              <div class="rounded-xl border border-white/10 bg-white/5 p-3.5"><p class="text-[11px] font-medium uppercase tracking-wider text-slate-400">Avg. response</p><p class="mt-1 text-2xl font-semibold text-white">12 <span class="text-sm text-slate-400">min</span></p></div>
            </div>
            </div>
          </div>
        </div>
