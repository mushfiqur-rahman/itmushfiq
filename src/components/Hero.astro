              loading="eager"
              fetchpriority="high"
            />
            <div
              class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-[#071225] via-[#071225]/90 to-transparent p-6"
            >
              <p
                class="mb-1 text-xs font-bold uppercase tracking-[0.16em] text-[#c4ff69]"
