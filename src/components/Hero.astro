---

---

<section
  id="hero"
  class="relative w-full min-h-[90vh] flex items-center justify-center bg-white dark:bg-[#0f0224] transition-colors duration-500 overflow-hidden pt-24 pb-16"
  aria-labelledby="hero-heading"
>
  <!-- Background Glow & Creative Elements (CSS Shapes) -->
  <div
    class="absolute inset-0 z-0 pointer-events-none opacity-20 dark:opacity-40"
  >
    <div
      class="absolute top-[-10%] right-[-5%] w-100 h-100 bg-[#90ee02] rounded-full mix-blend-multiply dark:mix-blend-overlay filter blur-[120px] animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-[-10%] left-[-10%] w-100 h-100 bg-[#2D058A] rounded-full mix-blend-multiply dark:mix-blend-overlay filter blur-[150px]"
    >
    </div>
  </div>

  <div class="container mx-auto px-6 md:px-12 lg:px-24 relative z-10">
    <div class="max-w-5xl">
      <!-- AEO/SEO Optimized Eyebrow (Brand Positioning) -->
      <p
        class="inline-block py-1.5 px-5 mb-8 text-sm md:text-base font-bold tracking-widest uppercase border-2 border-[#2D058A] text-[#2D058A] dark:border-[#90ee02] dark:text-[#90ee02] rounded-full"
      >
        Enterprise IT & Automation Expert
      </p>

      <!-- Giant Typography (Modern Bold H1) -->
      <h1
        id="hero-heading"
        class="text-6xl md:text-7xl lg:text-[5.5rem] font-black leading-[1.05] tracking-tighter text-[#2D058A] dark:text-white mb-8"
      >
        Bulletproof Email. <br />
        Seamless <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:from-[#90ee02] dark:to-[#ccff66]"
          >Cloud.</span
        >
        <br />
        Smart Automation.
      </h1>

      <!-- Problem-Solving Subheadline (CRO Focused) -->
      <p
        class="text-xl md:text-2xl text-slate-700 dark:text-slate-300 font-medium mb-12 max-w-3xl leading-relaxed"
      >
        Stop losing leads to the spam folder and fighting with messy
        infrastructure. I execute zero-downtime email migrations, configure
        advanced cold email systems, and build automated workflows so you can
        focus on scaling your business.
      </p>

      <!-- Call To Action (High Contrast Neo-brutalism Style) -->
      <div class="flex flex-col sm:flex-row gap-6">
        <!-- Primary CTA: High contrast Neon Green bg with Deep Purple text -->
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-4 text-xl font-bold text-[#2D058A] bg-[#90ee02] border-4 border-[#2D058A] dark:border-[#90ee02] transition-all duration-300 shadow-[8px_8px_0px_0px_rgba(45,5,138,1)] dark:shadow-[8px_8px_0px_0px_rgba(144,238,2,0.4)] hover:shadow-none hover:translate-x-8px hover:translate-y-2 focus:outline-none focus:ring-4 focus:ring-[#90ee02]/50"
          aria-label="Book a strategy call to fix your infrastructure"
        >
          Fix My Infrastructure
          <svg
            class="w-6 h-6 ml-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>

        <!-- Secondary CTA -->
        <a
          href="#services"
          class="inline-flex items-center justify-center px-8 py-4 text-xl font-bold text-[#2D058A] dark:text-[#90ee02] bg-transparent border-4 border-[#2D058A] dark:border-[#90ee02] hover:bg-[#2D058A] hover:text-white dark:hover:bg-[#90ee02] dark:hover:text-[#2D058A] transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-[#2D058A]/30"
        >
          Explore Solutions
        </a>
      </div>
    </div>
  </div>
</section>
