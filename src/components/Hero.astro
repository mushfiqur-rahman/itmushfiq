<!-- 1. HERO SECTION (London Focused) -->
<section
  class="relative dark:text-white pt-32 pb-24 overflow-hidden border-b-4 border-[#2D058A]"
>
  <!-- Background grid texture -->
  <div
    class="absolute inset-0 opacity-10 bg-[radial-gradient(#90ee02_1px,transparent_1px)] bg-size-[24px_24px]"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Value Prop -->
      <div class="lg:col-span-7">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 bg-[#90ee02] text-[#2D058A] font-black uppercase tracking-widest text-xs rounded-full border-2 border-[#2D058A] shadow-[2px_2px_0px_0px_#2D058A]"
        >
          <span class="w-2 h-2 rounded-full bg-[#2D058A] animate-ping"></span>
          Managed IT Services
        </div>

        <h1
          class="text-5xl sm:text-6xl md:text-7xl font-black uppercase tracking-tight leading-[0.95] mb-8"
        >
          Reliable Remote <br />
          <span class="text-[#90ee02]">IT Support</span>
          <br />
          In London.
        </h1>

        <p
          class="text-lg md:text-xl dark:text-slate-300 font-medium leading-relaxed max-w-xl mb-10"
        >
          Stop fighting with technology. We provide fast, secure, and proactive
          IT management for London-based businesses, ensuring your team can work
          without frustrating interruptions.
        </p>

        <div class="flex flex-wrap items-center gap-5">
          <a
            href="/contact"
            class="px-8 py-4 bg-[#90ee02] text-[#2D058A] font-black uppercase tracking-wider text-base border-4 border-[#2D058A] rounded-xl shadow-[6px_6px_0px_0px_#2D058A] hover:-translate-y-1 transition-all"
          >
            Get Support Today
          </a>
          <a
            href="#services"
            class="px-8 py-4 bg-transparent dark:text-white font-bold uppercase tracking-wider text-base border-2 border-white/20 rounded-xl hover:border-[#90ee02] hover:text-[#90ee02] transition-colors"
          >
            Explore Services ↓
          </a>
        </div>
      </div>

      <!-- Right Column: Hero Visual with Dynamic Cutout Frame -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Neo-brutalist Green Offset Block -->
          <div
            class="absolute -inset-2 bg-[#90ee02] rounded-2xl transform -rotate-2"
          >
          </div>

          <!-- Image Card -->
          <div
            class="relative bg-[#150734] border-4 border-[#2D058A] rounded-2xl overflow-hidden shadow-2xl"
          >
            <!-- London Business / Office Image -->
            <img
              src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=900&q=80"
              alt="Corporate IT Support in London"
              class="w-full h-115 object-cover contrast-125 hover:grayscale-0 transition-all duration-500"
              loading="eager"
              fetchpriority="high"
            />
            <div
              class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-[#0d021f] via-[#0d021f]/90 to-transparent p-6"
            >
              <p
                class="text-xs uppercase font-black text-[#90ee02] tracking-widest mb-1"
              >
                UK Operations
              </p>
              <p class="text-base font-bold text-white leading-snug">
                Instant remote troubleshooting and enterprise security for
                modern businesses.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
