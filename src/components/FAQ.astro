---
const faqs = [
  {
    question: "How long does a zero-downtime email migration take?",
    answer: "Migration timelines depend on the number of users and data size. However, the cutover process is typically scheduled during off-hours or weekends, ensuring absolutely zero disruption to your daily business operations."
  },
  {
    question: "How do you guarantee my cold emails land in the primary inbox?",
    answer: "I implement strict authentication protocols including SPF, DKIM, and DMARC. I also configure custom tracking domains and warm-up strategies to build a bulletproof sender reputation before you launch your outreach campaigns."
  },
  {
    question: "Do you provide ongoing IT support after the initial setup?",
    answer: "Yes. Many of my clients retain me for ongoing systems administration, user management, device troubleshooting, and infrastructure monitoring to ensure everything runs smoothly long-term."
  },
  {
    question: "What platforms do you support for business automation?",
    answer: "I specialize in building custom AI workflows and integrations using tools like Zapier, n8n, Brevo, GoHighLevel, and various CRM platforms to eliminate your team's manual data entry."
  },
  {
    question: "What is your typical onboarding process?",
    answer: "We start with a comprehensive infrastructure audit to identify bottlenecks. Following that, I provide a detailed strategy and execution plan. Once approved, I handle the complete technical implementation."
  }
];
---

<section id="faq" class="py-24 bg-white dark:bg-[#0f0224] border-y border-[#2D058A]/10 dark:border-white/10 relative overflow-hidden">
  <div class="max-w-360 mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
      
      <!-- FAQ Header (Left Column on Desktop) -->
      <div class="lg:col-span-5 lg:sticky lg:top-32">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 text-sm font-bold tracking-widest uppercase border-2 border-[#2D058A] text-[#2D058A] dark:border-[#90ee02] dark:text-[#90ee02] rounded-full">
          Got Questions?
        </div>
        <h2 class="text-4xl md:text-5xl font-black text-[#2D058A] dark:text-white tracking-tighter mb-6 leading-[1.1]">
          Frequently Asked Questions.
        </h2>
        <p class="text-xl text-slate-700 dark:text-slate-300 font-medium mb-8">
          Everything you need to know about my services, migration process, and how we can work together.
        </p>
        
        <!-- CTA inside FAQ -->
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-lg font-bold text-white dark:text-[#2D058A] bg-[#2D058A] dark:bg-[#90ee02] border-2 border-[#2D058A] dark:border-[#90ee02] rounded-xl hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(144,238,2,1)] dark:hover:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.8)] transition-all duration-300">
          Book a Free Consultation
        </a>
      </div>

      <!-- FAQ Accordion (Right Column on Desktop) -->
      <div class="lg:col-span-7 space-y-4">
        {faqs.map((faq, index) => (
          <details class="group bg-white dark:bg-[#150734] border-2 border-[#2D058A] dark:border-white/10 rounded-2xl shadow-[4px_4px_0px_0px_rgba(45,5,138,1)] dark:shadow-[4px_4px_0px_0px_rgba(144,238,2,0.4)] transition-all duration-300 open:border-[#2D058A] dark:open:border-[#90ee02] open:bg-slate-50 dark:open:bg-[#1c0a45]">
            
            <summary class="flex justify-between items-center cursor-pointer p-6 md:p-8 outline-none focus-visible:ring-4 focus-visible:ring-[#90ee02]/50 rounded-2xl">
              <h3 class="text-xl font-bold text-[#2D058A] dark:text-white group-hover:text-[#7b2cbf] dark:group-hover:text-[#90ee02] transition-colors pr-4">
                {faq.question}
              </h3>
              
              <!-- Animated Plus/Minus Icon -->
              <span class="relative shrink-0 w-8 h-8 flex items-center justify-center rounded-full border-2 border-[#2D058A] dark:border-[#90ee02] text-[#2D058A] dark:text-[#90ee02] group-open:bg-[#2D058A] dark:group-open:bg-[#90ee02] group-open:text-white dark:group-open:text-[#2D058A] transition-all duration-300">
                <svg class="w-5 h-5 absolute transition-transform duration-300 group-open:rotate-90 group-open:opacity-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16M4 12h16"></path></svg>
                <svg class="w-5 h-5 absolute opacity-0 transition-transform duration-300 -rotate-90 group-open:rotate-0 group-open:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M20 12H4"></path></svg>
              </span>
            </summary>
            
            <div class="px-6 pb-6 md:px-8 md:pb-8 text-lg font-medium text-slate-700 dark:text-slate-300 leading-relaxed">
              <div class="pt-4 border-t border-[#2D058A]/10 dark:border-white/10">
                {faq.answer}
              </div>
            </div>
            
          </details>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* Hide default browser marker for details/summary */
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>