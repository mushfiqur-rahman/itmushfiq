---
import TestimonialCard from './TestimonialCard.astro';

import { testimonials } from "../data/testimonials";
---

<section id="testimonials" class="testimonials-section relative py-24 overflow-hidden transition-colors duration-300">
  <div class="testimonials-atmosphere" aria-hidden="true">
    <div class="testimonials-grid"></div>
    <div class="testimonials-glass"></div>
    <div class="testimonials-horizon"></div>
  </div>
  <div class="relative z-10 max-w-360 mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 text-sm font-bold tracking-widest uppercase border-2 border-[#2D058A] text-[#2D058A] dark:border-[#90ee02] dark:text-[#90ee02] rounded-full">
        Wall of Love
      </div>
      <h2 class="text-4xl md:text-5xl font-black text-[#2D058A] dark:text-white tracking-tighter mb-6">
        Don't just take my word for it.
      </h2>
      <p class="text-xl text-slate-700 dark:text-slate-300 font-medium">
        Hear from CEOs, founders, and directors who have transformed their infrastructure and workflow with my services.
      </p>
    </div>

    <!-- Swiper Carousel (Max width 4xl for perfect readability) -->
    <div class="max-w-4xl mx-auto">
      <div class="swiper testimonial-swiper pb-16 px-4 md:px-8"> <!-- Padding added so shadows don't get cut off -->
        <div class="swiper-wrapper items-stretch">
          {testimonials.map((item) => (
            <div class="swiper-slide h-auto"> <!-- Removed width classes so it takes full width -->
              <TestimonialCard 
                feedback={item.feedback}
                rating={item.rating}
                name={item.name}
                avatar={item.avatar}
                designation={item.designation}
                work={item.work}
              />
            </div>
          ))}
        </div>
        <!-- Custom Pagination Container -->
        <div class="swiper-pagination bottom-0!"></div>
      </div>
    </div>

  </div>
</section>

<!-- Astro Script for Swiper -->
<script>
  import Swiper from 'swiper';
  import { Autoplay, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  document.addEventListener('DOMContentLoaded', () => {
    new Swiper('.testimonial-swiper', {
      modules: [Autoplay, Pagination],
      loop: true,
      slidesPerView: 1, // শুধুমাত্র ১টি স্লাইড দেখাবে
      spaceBetween: 40, // কার্ডের মাঝের গ্যাপ
      grabCursor: true,
      autoplay: {
        delay: 6000, // টেক্সট পড়ার জন্য সময় একটু বাড়িয়ে দেওয়া হয়েছে (6s)
        disableOnInteraction: false,
        pauseOnMouseEnter: true, // হোভার করলে থেমে থাকবে
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
        dynamicBullets: true,
      },
      // Breakpoints রিমুভ করা হয়েছে কারণ সব স্ক্রিনেই ১টি স্লাইড থাকবে
    });
  });
</script>

<style>

  .testimonials-section {
    isolation: isolate;
    background:
      radial-gradient(ellipse at 92% 12%, #90ee0260, transparent 42%),
      radial-gradient(ellipse at 8% 48%, #8049db55, transparent 48%),
      radial-gradient(ellipse at 70% 95%, #b9abf580, transparent 45%),
      linear-gradient(145deg, #f9faff, #f0eef8 55%, #f8fbf4);
    border-block: 1px solid #2d058a12;
  }

  .testimonials-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .testimonials-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(#70569e0b 1px, transparent 1px),
      linear-gradient(90deg, #70569e0b 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 65% 40%, black, transparent 75%);
  }

  .testimonials-atmosphere::before {
    content: "";
    position: absolute;
    width: min(70vw, 950px);
    aspect-ratio: 1;
    top: -35%;
    right: -12%;
    border-radius: 50%;
    border: 1px solid #9c76e645;
    box-shadow: 0 0 0 50px #9c76e608, 0 0 0 100px #9c76e608,
      inset 0 0 90px #90ee0220, 0 0 100px #9c76e620;
  }

  .testimonials-glass {
    position: absolute;
    inset: 64px max(20px, calc((100% - 1360px) / 2));
    border: 1px solid #ffffffb3;
    border-radius: 40px;
    background: linear-gradient(125deg, #ffffff70, #ffffff12 45%, #ffffff38);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: inset 0 1px 0 #fff, 0 24px 90px #2d058a06;
  }

  .testimonials-glass::before,
  .testimonials-glass::after {
    content: "";
    position: absolute;
    height: 1px;
    width: 45%;
    background: linear-gradient(90deg, transparent, #a788e6, transparent);
  }

  .testimonials-glass::before { top: -1px; left: 6%; }
  .testimonials-glass::after { bottom: -1px; right: 6%; }

  .testimonials-horizon {
    position: absolute;
    top: 0;
    left: 15%;
    width: 70%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #9c76e6, #90ee0280, transparent);
    box-shadow: 0 0 28px #9566ee45;
  }

  :global(.dark) .testimonials-section {
    background:
      radial-gradient(ellipse at 95% 8%, #90ee0238, transparent 38%),
      radial-gradient(ellipse at 0% 45%, #7236da85, transparent 50%),
      radial-gradient(ellipse at 75% 100%, #6436b875, transparent 50%),
      linear-gradient(145deg, #0e071b, #100a20 55%, #090d14);
    border-color: #ffffff0d;
  }

  :global(.dark) .testimonials-grid {
    background-image:
      linear-gradient(#c4b5fd09 1px, transparent 1px),
      linear-gradient(90deg, #c4b5fd09 1px, transparent 1px);
  }

  :global(.dark) .testimonials-glass {
    border-color: #ffffff20;
    background: linear-gradient(125deg, #ffffff0e, #ffffff01 45%, #ffffff08);
    box-shadow: inset 0 1px 0 #ffffff0a, 0 24px 90px #00000018;
  }

  :global(.dark) .testimonials-glass::before,
  :global(.dark) .testimonials-glass::after {
    background: linear-gradient(90deg, transparent, #a98ae480, #90ee0240, transparent);
  }

  @media (max-width: 639px) {
    .testimonials-glass { inset: 40px 8px; border-radius: 24px; }
    .testimonials-grid { background-size: 48px 48px; }
  }

  /* Custom Neo-brutalist styling for Swiper Pagination Dots */
  :global(.testimonial-swiper .swiper-pagination-bullet) {
    background-color: #2D058A;
    opacity: 0.3;
    width: 10px;
    height: 10px;
    transition: all 0.3s ease;
  }
  
  :global(.dark .testimonial-swiper .swiper-pagination-bullet) {
    background-color: #ffffff;
  }

  :global(.testimonial-swiper .swiper-pagination-bullet-active) {
    opacity: 1;
    background-color: #90ee02;
    border: 2px solid #2D058A;
    transform: scale(1.5);
  }
  
  :global(.dark .testimonial-swiper .swiper-pagination-bullet-active) {
    background-color: #90ee02;
    border: 2px solid #0f0224;
  }
</style>
