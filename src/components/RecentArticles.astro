---
import ArticleCard from './ArticleCard.astro';
import { getPosts } from '../utils/posts';

// Featured IDs must be regular blog posts; fill remaining slots with newest posts.
const featuredIds = ['business-emails-going-to-spam', 'business-email-migration-checklist'];
const all = await getPosts('blog');
const posts = [
  ...featuredIds.flatMap(id => all.filter(post => post.id === id)),
  ...all.filter(post => !featuredIds.includes(post.id)),
].slice(0, 3);
---

<section class="relative overflow-hidden bg-[#0b0b0e] py-18 text-white sm:py-24">
  <div class="pointer-events-none absolute -right-24 top-0 h-80 w-80 rounded-full bg-[#2D058A]/30 blur-[110px]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <span class="inline-flex rounded-full border border-white/15 bg-white/5 px-3 py-1 text-[10px] font-bold uppercase tracking-[.16em] text-[#90ee02]">Useful insights</span>
        <h2 class="mt-4 text-4xl font-semibold leading-[1.04] tracking-tighter text-white sm:text-5xl">Practical IT guidance,<br /><span class="text-[#90ee02]">without the jargon.</span></h2>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="/case-studies/" class="group inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-[#90ee02]">Client case studies <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></a>
        <a href="/blog/" class="group inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-[#90ee02]">View all articles <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></a>
      </div>
    </header>

    <div class="grid gap-6 lg:grid-cols-3">
      {posts.map(post => <ArticleCard post={post} />)}
    </div>
  </div>
</section>
