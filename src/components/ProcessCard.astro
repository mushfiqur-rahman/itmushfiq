---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<article
  class="group relative overflow-hidden p-8 md:p-10 bg-white dark:bg-[#150734] border border-slate-200 dark:border-white/5 rounded-2xl hover:border-[#2D058A] dark:hover:border-[#90ee02]/50 hover:shadow-xl dark:hover:shadow-[#90ee02]/5 transition-all duration-300"
>
  <!-- Background Number Watermark -->
  <div
    class="absolute top-2 right-4 text-[8rem] font-black text-slate-100 dark:text-white/5 pointer-events-none select-none transition-transform duration-500 group-hover:scale-110 group-hover:-translate-y-2 group-hover:-translate-x-2"
    aria-hidden="true"
  >
    {number}
  </div>

  <!-- Icon Box -->
  <div
    class="relative z-10 w-14 h-14 mb-8 rounded-xl bg-[#2D058A] dark:bg-[#2D058A]/80 flex items-center justify-center text-[#90ee02] shadow-md border border-[#2D058A]/20 dark:border-[#90ee02]/20"
  >
    <slot name="icon" />
  </div>

  <!-- Content -->
  <div class="relative z-10">
    <h3
      class="text-xl md:text-2xl font-bold text-[#2D058A] dark:text-white mb-4 tracking-tight"
    >
      {title}
    </h3>
    <p class="text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
      {description}
    </p>
  </div>
</article>
