---
import { Icon } from "astro-icon/components";

// Include country code without '+' or spaces (e.g., 447123456789 or 8801712345678)
const whatsappNumber = "+447988585324";
const message = encodeURIComponent(
  "Hello IT Support Bee, I need assistance with...",
);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${message}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp"
  class="fixed bottom-6 left-6 z-50 group flex items-center justify-center w-14 h-14 bg-[#25D366] text-white border-4 border-[#2D058A] dark:border-white rounded-2xl shadow-[4px_4px_0px_0px_#2D058A] dark:shadow-[4px_4px_0px_0px_#90ee02] hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#2D058A] dark:hover:shadow-[6px_6px_0px_0px_#90ee02] transition-all duration-300"
>
  <!-- Subtle Pulse Ring -->
  <span
    class="absolute inset-0 rounded-xl bg-[#25D366] animate-ping opacity-25 pointer-events-none"
  ></span>

  <!-- Official WhatsApp Brand Icon -->
  <Icon name="simple-icons:whatsapp" class="w-7 h-7" />

  <!-- Hover Tooltip -->
  <span
    class="absolute left-16 px-3 py-1.5 bg-[#2D058A] text-white font-black text-xs uppercase tracking-wider rounded-lg border-2 border-[#90ee02] whitespace-nowrap opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 pointer-events-none shadow-lg hidden sm:block"
  >
    WhatsApp Us
  </span>
</a>
