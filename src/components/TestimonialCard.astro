---
interface Props {
  feedback: string;
  rating: number;
  name: string;
  avatar: string;
  designation: string;
  work: string;
}

const { feedback, rating, name, avatar, designation, work } = Astro.props;
---

<article
  class="flex flex-col h-full p-6 md:p-8 bg-white dark:bg-[#150734] border-2 border-[#2D058A] dark:border-white/10 rounded-2xl shadow-[4px_4px_0px_0px_rgba(45,5,138,1)] dark:shadow-[4px_4px_0px_0px_rgba(144,238,2,0.4)] hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_rgba(45,5,138,1)] dark:hover:shadow-[6px_6px_0px_0px_rgba(144,238,2,0.6)] transition-all duration-300"
>
  <!-- Rating Stars -->
  <div class="flex gap-1 mb-4" aria-label={`Rating: ${rating} out of 5 stars`}>
    {
      Array.from({ length: 5 }).map((_, i) => (
        <svg
          class={`w-5 h-5 ${i < rating ? "text-[#2D058A] dark:text-[#90ee02]" : "text-slate-200 dark:text-slate-700"}`}
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))
    }
  </div>

  <!-- Feedback Text (flex-grow ensures footer stays at bottom) -->
  <blockquote
    class="grow text-slate-700 dark:text-slate-300 text-lg leading-relaxed mb-6 font-medium"
  >
    "{feedback}"
  </blockquote>

  <!-- Client Info -->
  <div
    class="flex items-center gap-4 pt-4 border-t border-[#2D058A]/10 dark:border-white/10 mt-auto"
  >
    <img
      src={avatar}
      alt={name}
      width="48"
      height="48"
      class="w-12 h-12 rounded-full border-2 border-[#2D058A] dark:border-[#90ee02] object-cover bg-slate-100"
      loading="lazy"
      onerror="this.src='/clients/avatar.png'"
    />
    <div>
      <h4
        class="font-bold text-[#2D058A] dark:text-white text-base leading-tight"
      >
        {name}
      </h4>
      <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mb-0.5">
        {designation}
      </p>
      <p
        class="text-[10px] text-slate-400 dark:text-slate-500 uppercase tracking-wider leading-tight"
      >
        {work}
      </p>
    </div>
  </div>
</article>
