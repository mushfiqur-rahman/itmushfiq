---
import ServiceCard from "./ServiceCard.astro";

const services = [
  {
    title: "Email Migration",
    desc: "Seamless, zero-downtime migrations across Microsoft 365 and Google Workspace with complete data fidelity.",
    href: "/services/email-migration",
    icon: "lucide:mail-plus",
  },
  {
    title: "Email Deliverability",
    desc: "Stop critical communication from landing in spam. Strict SPF, DKIM, and DMARC enforcement.",
    href: "/services/email-deliverability",
    icon: "lucide:shield-check",
  },
  {
    title: "Workspace Management",
    desc: "Structured cloud administration, centralized drive hierarchies, and enterprise access protocols.",
    href: "/services/workspace-management",
    icon: "lucide:layout-dashboard",
  },
  {
    title: "Business Automation",
    desc: "Eliminate repetitive manual data entry by connecting software pipelines into unified workflows.",
    href: "/services/business-automation",
    icon: "lucide:bot",
  },
  {
    title: "Web Engineering",
    desc: "High-performance, instant-loading web platforms engineered for maximum search visibility and conversions.",
    href: "/services/web-development",
    icon: "lucide:code-2",
  },
  {
    title: "Remote IT Helpdesk",
    desc: "Rapid-response remote troubleshooting, continuous device security, and seamless onboarding.",
    href: "/services/remote-it-support",
    icon: "lucide:headset",
  },
];
---

<section
  id="services"
  class="relative py-32 bg-slate-50 dark:bg-[#0a0118] overflow-hidden border-y-4 border-[#2D058A] dark:border-white/10 transition-colors duration-300"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,var(--tw-gradient-stops))] from-[#90ee02]/20 via-slate-50 to-slate-50 dark:hidden"
  >
  </div>
  <div
    class="absolute inset-0 opacity-[0.03] bg-[linear-gradient(to_right,#000000_1px,transparent_1px),linear-gradient(to_bottom,#000000_1px,transparent_1px)] bg-size-[40px_40px] dark:hidden"
  >
  </div>

  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,var(--tw-gradient-stops))] from-[#2D058A]/20 via-[#0a0118] to-[#0a0118] hidden dark:block"
  >
  </div>
  <div
    class="absolute inset-0 opacity-[0.03] bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] bg-size-[40px_40px] hidden dark:block"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6"
    >
      <div>
        <span
          class="inline-block px-3 py-1 mb-4 bg-white/60 dark:bg-white/10 backdrop-blur-md border border-[#2D058A]/20 dark:border-white/20 text-[#2D058A] dark:text-[#90ee02] font-black uppercase tracking-widest text-[10px] rounded-full shadow-sm dark:shadow-none"
        >
          Our Expertise
        </span>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight leading-none text-[#2D058A] dark:text-white"
        >
          Engineered For <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:text-[#90ee02] dark:bg-none"
            >Stability & Scale.</span
          >
        </h2>
      </div>
      <p
        class="text-slate-600 dark:text-slate-400 max-w-sm font-medium text-sm leading-relaxed mb-2"
      >
        Comprehensive cloud architectures and hands-on operational management
        tailored for modern business growth.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        services.map((service) => (
          <ServiceCard
            title={service.title}
            desc={service.desc}
            href={service.href}
            icon={service.icon}
          />
        ))
      }
    </div>
  </div>
</section>
