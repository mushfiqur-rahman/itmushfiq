---
import ServiceCard from "./ServiceCard.astro";

const services = [
  {
    "title": "Email Migration",
    "desc": "Move between Microsoft 365, Google Workspace, and legacy email systems with a planned cutover and checks on supported mailbox data.",
    "href": "/services/email-migration",
    "icon": "lucide:mail-plus"
  },
  {
    "title": "Email Deliverability",
    "desc": "Business emails going to spam? Get help with SPF, DKIM, DMARC, sender reputation, and delivery troubleshooting.",
    "href": "/services/email-deliverability",
    "icon": "lucide:shield-check"
  },
  {
    "title": "Google Workspace Management",
    "desc": "Get help with Gmail, user accounts, shared files, access security, and employee onboarding and offboarding.",
    "href": "/services/workspace-management",
    "icon": "lucide:layout-dashboard"
  },
  {
    "title": "Microsoft 365 Management",
    "desc": "Manage Microsoft 365 accounts, licenses, secure access, and supported devices with Intune and Entra ID.",
    "href": "/services/microsoft-365-management",
    "icon": "lucide:monitor-smartphone"
  },
  {
    "title": "Email Marketing Automation",
    "desc": "Connect lead capture, audience segments, welcome emails, and follow-up sequences into a working email marketing system.",
    "href": "/services/email-marketing",
    "icon": "lucide:mail"
  },
  {
    "title": "Business Automation",
    "desc": "Connect your CRM, email, and business applications to reduce repetitive data entry and streamline client onboarding.",
    "href": "/services/business-automation",
    "icon": "lucide:bot"
  },
  {
    "title": "Remote IT Helpdesk",
    "desc": "Get remote help with email, account access, software, and everyday IT problems, with ongoing support scoped to your team.",
    "href": "/services/remote-it-support",
    "icon": "lucide:headset"
  }
];
---

<section
  id="services"
  class="services-section relative py-32 overflow-hidden transition-colors duration-300"
>
  <div class="services-atmosphere" aria-hidden="true">
    <div class="services-grid"></div>
    <div class="services-glass"></div>
    <div class="services-horizon"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6"
    >
      <div>
        <span
          class="inline-block px-3 py-1 mb-4 bg-white/60 dark:bg-white/10 backdrop-blur-md border border-[#2D058A]/20 dark:border-white/20 text-[#2D058A] dark:text-[#90ee02] font-black uppercase tracking-widest text-[10px] rounded-full shadow-sm dark:shadow-none"
        >
          IT Support for Growing Teams
        </span>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight leading-none text-[#2D058A] dark:text-white"
        >
          Less IT Friction. <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:text-[#90ee02] dark:bg-none"
            >More Time to Grow.</span
          >
        </h2>
      </div>
      <p
        class="text-slate-600 dark:text-slate-400 max-w-sm font-medium text-sm leading-relaxed mb-2"
      >
        Email issues, device problems, and repetitive tasks cost your team time.
        We take care of your everyday IT so you can focus on customers and growing
        your business.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        services.map((service) => (
          <ServiceCard
            title={service.title}
            desc={service.desc}
            href={service.href}
            icon={service.icon}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-section {
    isolation: isolate;
    background:
      radial-gradient(ellipse at 92% 12%, #90ee0260, transparent 42%),
      radial-gradient(ellipse at 8% 48%, #8049db55, transparent 48%),
      radial-gradient(ellipse at 70% 95%, #b9abf580, transparent 45%),
      linear-gradient(145deg, #f9faff, #f0eef8 55%, #f8fbf4);
    border-block: 1px solid #2d058a12;
  }

  .services-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .services-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(#70569e0b 1px, transparent 1px),
      linear-gradient(90deg, #70569e0b 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 65% 40%, black, transparent 75%);
  }

  .services-atmosphere::before {
    content: "";
    position: absolute;
    width: min(70vw, 950px);
    aspect-ratio: 1;
    top: -35%;
    right: -12%;
    border-radius: 50%;
    border: 1px solid #9c76e645;
    box-shadow: 0 0 0 50px #9c76e608, 0 0 0 100px #9c76e608,
      inset 0 0 90px #90ee0220, 0 0 100px #9c76e620;
  }

  .services-glass {
    position: absolute;
    inset: 64px max(20px, calc((100% - 1360px) / 2));
    border: 1px solid #ffffffb3;
    border-radius: 40px;
    background: linear-gradient(125deg, #ffffff70, #ffffff12 45%, #ffffff38);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: inset 0 1px 0 #fff, 0 24px 90px #2d058a06;
  }

  .services-glass::before,
  .services-glass::after {
    content: "";
    position: absolute;
    height: 1px;
    width: 45%;
    background: linear-gradient(90deg, transparent, #a788e6, transparent);
  }

  .services-glass::before { top: -1px; left: 6%; }
  .services-glass::after { bottom: -1px; right: 6%; }

  .services-horizon {
    position: absolute;
    top: 0;
    left: 15%;
    width: 70%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #9c76e6, #90ee0280, transparent);
    box-shadow: 0 0 28px #9566ee45;
  }

  :global(.dark) .services-section {
    background:
      radial-gradient(ellipse at 95% 8%, #90ee0238, transparent 38%),
      radial-gradient(ellipse at 0% 45%, #7236da85, transparent 50%),
      radial-gradient(ellipse at 75% 100%, #6436b875, transparent 50%),
      linear-gradient(145deg, #0e071b, #100a20 55%, #090d14);
    border-color: #ffffff0d;
  }

  :global(.dark) .services-grid {
    background-image:
      linear-gradient(#c4b5fd09 1px, transparent 1px),
      linear-gradient(90deg, #c4b5fd09 1px, transparent 1px);
  }

  :global(.dark) .services-glass {
    border-color: #ffffff20;
    background: linear-gradient(125deg, #ffffff0e, #ffffff01 45%, #ffffff08);
    box-shadow: inset 0 1px 0 #ffffff0a, 0 24px 90px #00000018;
  }

  :global(.dark) .services-glass::before,
  :global(.dark) .services-glass::after {
    background: linear-gradient(90deg, transparent, #a98ae480, #90ee0240, transparent);
  }

  @media (max-width: 639px) {
    .services-glass { inset: 40px 8px; border-radius: 24px; }
    .services-grid { background-size: 48px 48px; }
  }
</style>
