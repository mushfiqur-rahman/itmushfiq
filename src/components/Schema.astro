---
import { site } from "../data/site";
import services from "../data/services.json";
import faqs from "../data/faqs.json";
const { title, description, url } = Astro.props;
const origin = "https://itsupportbee.com";
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": origin + "/#organization", name: "IT Support Bee", url: origin, description: site.bio, logo: origin + "/favicon.svg", email: site.email, sameAs: site.socials.filter(s => s.label === "X (Twitter)").map(s => s.url), founder: { "@id": origin + "/#founder" }, contactPoint: { "@type": "ContactPoint", email: site.email, contactType: "customer support", url: origin + "/contact", availableLanguage: "English" } },
    { "@type": "Person", "@id": origin + "/#founder", name: site.name, jobTitle: site.role, url: origin + "/about", sameAs: site.socials.filter(s => !["Agency", "X (Twitter)"].includes(s.label)).map(s => s.url), worksFor: { "@id": origin + "/#organization" } },
    { "@type": "WebSite", "@id": origin + "/#website", url: origin, name: "IT Support Bee", publisher: { "@id": origin + "/#organization" }, inLanguage: "en" },
    { "@type": "WebPage", "@id": url + "#webpage", url, name: title, description, isPartOf: { "@id": origin + "/#website" }, inLanguage: "en" },
    ...(new URL(url).pathname === "/" ? [
      ...services.map(service => ({ "@type": "Service", "@id": origin + service.href + "#service", name: service.title, description: service.desc, url: origin + service.href, provider: { "@id": origin + "/#organization" } })),
      { "@type": "FAQPage", "@id": origin + "/#faq", mainEntity: faqs.map(faq => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) }
    ] : [])
  ]
};
---
<script type="application/ld+json" set:html={JSON.stringify(schemaData).replace(/</g, "\u003c")} />
