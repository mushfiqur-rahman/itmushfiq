---
import { Icon } from "astro-icon/components";
const currentYear = new Date().getFullYear();

const solutions = [
  { name: "Email Migrations", path: "/services/email-migration" },
  { name: "Cold Email Setup", path: "/services/cold-email" },
  { name: "AI Automation", path: "/services/ai-automation" },
  { name: "Cloud Administration", path: "/services/cloud-admin" },
];

const company = [
  { name: "About", path: "/about" },
  { name: "Blog", path: "/blog" },
  { name: "Contact", path: "/contact" },
];

const socials = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/company/itsupportbee",
    Icon: "lucide:linkedin",
  },
  {
    name: "GitHub",
    url: "https://github.com/mushfiqur-rahman",
    Icon: "lucide:github",
  },
  {
    name: "X / Twitter",
    url: "https://x.com/itsupportbee",
    Icon: "lucide:twitter",
  },
  {
    name: "Youtube",
    url: "https://youtube.com/itsupportbee",
    Icon: "lucide:youtube",
  },
];
---

<footer
  class="bg-[#0f0224] border-t-4 border-[#90ee02] relative overflow-hidden"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <!-- Pre-Footer CTA -->
  <div class="border-b border-white/10 relative z-10">
    <div
      class="max-w-360 mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20 flex flex-col lg:flex-row items-center justify-between gap-8"
    >
      <div class="text-center lg:text-left max-w-2xl">
        <h3
          class="text-3xl md:text-5xl font-black text-white tracking-tighter mb-4"
        >
          Ready to bulletproof your infrastructure?
        </h3>
        <p class="text-lg text-slate-400 font-medium">
          Let’s eliminate downtime, automate workflows, and scale your business
          securely.
        </p>
      </div>

      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 text-xl font-bold text-[#2D058A] bg-[#90ee02] border-4 border-[#90ee02] transition-all duration-300 shadow-[6px_6px_0px_0px_rgba(255,255,255,0.2)] hover:shadow-none hover:translate-x-1.5 hover:translate-y-1.5 focus:outline-none focus:ring-4 focus:ring-[#90ee02]/50 whitespace-nowrap"
      >
        Book a Strategy Call
        <svg
          class="w-6 h-6 ml-3"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
        >
      </a>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="max-w-360 mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8"
    >
      <!-- Brand & Bio -->
      <div class="lg:col-span-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 group mb-6 outline-none focus-visible:ring-4 focus-visible:ring-[#90ee02]/50 rounded-lg"
        >
          <span
            class="text-3xl font-black text-white tracking-tight group-hover:text-[#90ee02] transition-colors"
          >
            IT Support <span class="text-[#90ee02]">Bee</span>
          </span>
        </a>
        <p class="text-slate-400 font-medium leading-relaxed mb-8 max-w-sm">
          Enterprise IT Support & Cloud Administration for modern businesses.
          Solving complex infrastructure problems so you don't have to.
        </p>

        <!-- Email Link -->
        <a
          href="mailto:hello@itsupportbee.com"
          class="inline-flex items-center gap-2 text-lg font-bold text-white hover:text-[#90ee02] transition-colors outline-none focus-visible:ring-4 focus-visible:ring-[#90ee02]/50 rounded-lg"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path></svg
          >
          hello@itsupportbee.com
        </a>
      </div>

      <!-- Solutions Nav -->
      <div class="lg:col-span-3 lg:col-start-6">
        <h4 class="text-sm font-bold tracking-widest uppercase text-white mb-6">
          Solutions
        </h4>
        <ul class="space-y-4">
          {
            solutions.map((item) => (
              <li>
                <a
                  href={item.path}
                  class="text-slate-400 hover:text-[#90ee02] font-medium transition-colors outline-none focus-visible:ring-4 focus-visible:ring-[#90ee02]/50 rounded-md inline-block"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company Nav -->
      <div class="lg:col-span-2">
        <h4 class="text-sm font-bold tracking-widest uppercase text-white mb-6">
          Company
        </h4>
        <ul class="space-y-4">
          {
            company.map((item) => (
              <li>
                <a
                  href={item.path}
                  class="text-slate-400 hover:text-[#90ee02] font-medium transition-colors outline-none focus-visible:ring-4 focus-visible:ring-[#90ee02]/50 rounded-md inline-block"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Socials -->
      <div class="lg:col-span-2">
        <h4 class="text-sm font-bold tracking-widest uppercase text-white mb-6">
          Connect
        </h4>
        <div class="flex flex-wrap gap-4">
          {
            socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="w-10 h-10 flex items-center justify-center bg-white/5 border border-white/10 rounded-lg text-slate-400 hover:bg-[#90ee02] hover:text-[#2D058A] hover:border-[#90ee02] transition-all duration-300 outline-none focus-visible:ring-4 focus-visible:ring-[#90ee02]/50 hover:-translate-y-1"
              >
                <Icon name={social.Icon} class="w-6 h-6" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar (Copyright & Legal) -->
  <div class="border-t border-white/10 relative z-10">
    <div
      class="max-w-360 mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col md:flex-row items-center justify-between gap-4"
    >
      <p class="text-sm text-slate-200 font-medium">
        &copy; {currentYear} IT Support Bee. All rights reserved.
      </p>

      <div class="flex items-center gap-6 text-sm text-slate-200 font-medium">
        <a
          href="/privacy-policy"
          class="text-slate-300 hover:text-white transition-colors outline-none focus-visible:ring-2 focus-visible:ring-[#90ee02]/50 rounded"
          >Privacy Policy</a
        >
        <a
          href="/terms"
          class="text-slate-300 hover:text-white transition-colors outline-none focus-visible:ring-2 focus-visible:ring-[#90ee02]/50 rounded"
          >Terms of Service</a
        >
      </div>
    </div>
  </div>

  <!-- Ambient Glow Effect (Subtle) -->
  <div
    class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-200 h-100 bg-[#90ee02]/10 rounded-full blur-[120px] pointer-events-none z-0"
  >
  </div>
</footer>
