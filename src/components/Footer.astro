---
import { Icon } from "astro-icon/components";
const currentYear = new Date().getFullYear();
const solutions = [
  { name: "Remote IT support", path: "/services/remote-it-support" },
  {
    name: "Microsoft 365 management",
    path: "/services/microsoft-365-management",
  },
  {
    name: "Google Workspace management",
    path: "/services/workspace-management",
  },
  { name: "Email migration", path: "/services/email-migration" },
  { name: "Email deliverability", path: "/services/email-deliverability" },
  { name: "Business automation", path: "/services/business-automation" },
];
const company = [
  { name: "About the team", path: "/about" },
  { name: "Insights & guides", path: "/blog" },
  { name: "Get in touch", path: "/contact" },
];
const socials = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/company/itsupportbee",
    icon: "linkedin",
  },
  {
    name: "GitHub",
    url: "https://github.com/mushfiqur-rahman",
    icon: "github",
  },
  { name: "X / Twitter", url: "https://x.com/itsupportbee", icon: "twitter" },
  { name: "YouTube", url: "https://youtube.com/itsupportbee", icon: "youtube" },
];
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://itsupportbee.com/#organization",
  name: "IT Support Bee",
  url: "https://itsupportbee.com",
  email: "hello@itsupportbee.com",
  telephone: "+447988585324",
  description:
    "Remote IT support, Microsoft 365 and Google Workspace management, email migration, email deliverability, and business automation.",
  address: [
    {
      "@type": "PostalAddress",
      streetAddress: "Software Technology Park",
      addressLocality: "Jashore",
      addressCountry: "BD",
    },
    {
      "@type": "PostalAddress",
      streetAddress: "9 New Change",
      addressLocality: "London",
      postalCode: "EC4M 9AG",
      addressCountry: "GB",
    },
  ],
  sameAs: socials.map((social) => social.url),
};
---

<footer class="bee-footer" aria-labelledby="footer-heading">
  <div class="footer-shell">
    <section class="cta-card" aria-labelledby="footer-heading">
      <div class="cta-copy">
        <h2 id="footer-heading">
          Better IT. <span>More room to grow.</span>
        </h2><p>
          From everyday support to your next big migration,<br
            class="wide-break"
          /> let’s make technology work for your business.
        </p>
      </div>
      <div class="cta-actions">
        <a class="primary" href="/contact"
          >Talk to an IT expert <Icon
            name="lucide:arrow-up-right"
            aria-hidden="true"
          /></a
        ><a class="secondary" href="https://wa.me/447988585324"
          ><Icon name="lucide:message-circle" aria-hidden="true" /> Or chat on WhatsApp
          <span aria-hidden="true">↗</span></a>
      </div>
      <div class="orbital" aria-hidden="true"></div>
    </section>
    <div class="footer-grid">
      <section class="panel brand-panel" aria-label="About IT Support Bee">
        <a class="brand" href="/" aria-label="IT Support Bee home"
          ><span class="brand-mark" aria-hidden="true">IT</span><span
            >Support <span class="lime">Bee</span></span
          ></a
        >
        <p>
          Remote IT support, cloud management, and email expertise for your
          business.
        </p>

        <nav class="social-links" aria-label="Follow IT Support Bee">
          {
            socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${social.name} (opens in a new tab)`}
              >
                <Icon name={`lucide:${social.icon}`} aria-hidden="true" />
              </a>
            ))
          }
        </nav>
      </section>
      <nav class="panel services-panel" aria-labelledby="footer-services">
        <h3 id="footer-services">Services</h3><ul>
          {
            solutions.map((item) => (
              <li>
                <a href={item.path}>
                  {item.name}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav class="panel company-panel" aria-labelledby="footer-company">
        <h3 id="footer-company">Company</h3><ul>
          {
            company.map((item) => (
              <li>
                <a href={item.path}>
                  {item.name}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <section class="panel contact-panel" aria-labelledby="footer-contact">
        <div>
          <h3 id="footer-contact">Contact our team</h3><a
            class="email"
            href="mailto:hello@itsupportbee.com"
            >hello@itsupportbee.com <Icon
              name="lucide:arrow-up-right"
              aria-hidden="true"
            /></a
          ><a class="phone" href="tel:+447988585324"
            ><Icon name="lucide:phone" aria-hidden="true" /> +44 7988 585324</a>
        </div><div class="offices">
          <address>
            <span>Jashore, Bangladesh</span>Software Technology Park<br
            />Jashore, Bangladesh
          </address><address>
            <span>London, United Kingdom</span>9 New Change<br />London EC4M
            9AG, UK
          </address>
        </div>
      </section>
    </div>
    <div class="footer-bottom">
      <p>&copy; {currentYear} IT Support Bee. All rights reserved.</p><nav
        aria-label="Legal"
      >
        <a href="/privacy-policy">Privacy policy</a><a href="/terms"
          >Terms of service</a>
      </nav><a class="back-top" href="#main-content"
        >Back to content <Icon name="lucide:arrow-up" aria-hidden="true" /></a>
    </div>
  </div>
</footer>
<script
  type="application/ld+json"
  set:html={JSON.stringify(organization).replace(/</g, "\u003c")}
/>
<style>
  .bee-footer {
    --purple: #2d058a;
    --lime: #90ee02;
    --muted: #c8c2d4;
    --line: #c6b5ee29;
    background: #0c071b;
    color: #f8f5ff;
    border-top: 1px solid var(--line);
    padding: 32px 24px 16px;
    font-size: 1rem;
    line-height: 1.6;
  }
  .footer-shell {
    max-width: 1180px;
    margin: auto;
  }
  .cta-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 28px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: linear-gradient(110deg, #251244, #171022);
  }
  .cta-copy h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.25;
    margin: 0 0 8px;
  }
  .cta-copy h2 span {
    color: #d9c5fa;
  }
  .cta-copy > p {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .wide-break,
  .orbital {
    display: none;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }
  .primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 48px;
    padding: 10px 20px;
    border-radius: 9px;
    background: var(--lime);
    color: var(--purple);
    font-size: 1rem;
    font-weight: 700;
  }
  .primary svg,
  .secondary svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .secondary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 0.875rem;
    color: #e1d7ef;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.05fr 1.15fr 0.65fr 1.15fr;
    gap: 28px;
    margin-top: 28px;
  }
  .panel {
    min-width: 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 40px;
    border-radius: 10px;
    background: var(--purple);
    color: var(--lime);
    font-size: 1rem;
  }
  .lime {
    color: var(--lime);
  }
  .brand-panel > p {
    color: var(--muted);
    font-size: 0.9375rem;
    margin: 16px 0;
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .social-links a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 9px;
    color: #d2c8e0;
  }
  .social-links svg {
    width: 18px;
    height: 18px;
  }
  .panel h3 {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 8px;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 6px 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  li a span {
    display: none;
  }
  .contact-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .email {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .email svg {
    width: 16px;
    height: 16px;
    color: var(--lime);
    flex-shrink: 0;
  }
  .phone {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .phone svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .offices {
    display: grid;
    gap: 12px;
  }
  address {
    font-style: normal;
    font-size: 0.875rem;
    color: var(--muted);
  }
  address span {
    display: block;
    color: #e1d3f3;
    font-weight: 500;
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: 24px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }
  .footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .footer-bottom a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .back-top svg {
    width: 16px;
    height: 16px;
  }
  .bee-footer a {
    border-radius: 4px;
    text-underline-offset: 4px;
  }
  .bee-footer a:hover {
    color: var(--lime);
    text-decoration: underline;
  }
  .bee-footer .primary:hover,
  .bee-footer .social-links a:hover {
    background: #afff37;
    color: var(--purple);
    text-decoration: none;
  }
  .bee-footer a:focus-visible {
    outline: 3px solid var(--lime);
    outline-offset: 4px;
  }
  .bee-footer .primary:focus-visible {
    outline-color: white;
  }
  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px 32px;
    }
    .offices {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }
  @media (max-width: 700px) {
    .bee-footer {
      padding: 24px 20px 16px;
    }
    .cta-card {
      flex-direction: column;
      align-items: stretch;
      padding: 20px;
      gap: 16px;
    }
    .cta-actions {
      align-items: stretch;
    }
    .secondary {
      justify-content: center;
    }
    .footer-grid {
      gap: 20px;
    }
    .brand-panel,
    .contact-panel {
      grid-column: 1 / -1;
    }
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (max-width: 380px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .offices {
      grid-template-columns: 1fr;
    }
  }
  @media (forced-colors: active) {
    .cta-card,
    .primary,
    .social-links a {
      border: 1px solid CanvasText;
    }
    .primary {
      background: ButtonFace;
      color: ButtonText;
    }
    .bee-footer a:focus-visible {
      outline-color: Highlight;
    }
  }
</style>
