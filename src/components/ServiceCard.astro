---
interface Props {
  number: string;
  category: string;
  title: string;
  items: string[];
  href: string;
}

const { number, category, title, items, href } = Astro.props;
---

<article
  class="group relative flex flex-col h-full p-8 md:p-10 bg-white dark:bg-[#150734] border border-slate-200 dark:border-white/5 rounded-2xl hover:border-[#2D058A] dark:hover:border-[#90ee02]/50 transition-colors duration-300 z-10"
>
  <!-- Category Header -->
  <div
    class="flex items-center gap-3 mb-6 text-sm font-black tracking-widest uppercase"
    aria-label={`Category: ${category}`}
  >
    <span class="text-[#2D058A] dark:text-[#90ee02]">{number}</span>
    <span class="text-slate-300 dark:text-slate-600" aria-hidden="true">•</span>
    <span class="text-slate-600 dark:text-white/80">{category}</span>
  </div>

  <!-- Title -->
  <h3
    class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-8 tracking-tight"
  >
    <a
      href={href}
      class="outline-none before:absolute before:inset-0 focus-visible:ring-4 focus-visible:ring-[#90ee02]/50 rounded-2xl"
    >
      {title}
    </a>
  </h3>

  <!-- Service List (AEO Optimized) -->
  <ul class="space-y-4 mb-8 grow" aria-label={`Services included in ${title}`}>
    {
      items.map((item) => (
        <li class="flex items-center gap-4 text-lg text-slate-600 dark:text-slate-300 font-medium">
          <span
            class="text-[#2D058A] dark:text-[#90ee02] font-black text-xl"
            aria-hidden="true"
          >
            —
          </span>
          {item}
        </li>
      ))
    }
  </ul>

  <!-- Hover CTA Indicator -->
  <div
    class="mt-auto self-start flex items-center text-[#2D058A] dark:text-[#90ee02] font-bold uppercase tracking-wider opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
  >
    Explore <span aria-hidden="true" class="ml-2">→</span>
  </div>
</article>
