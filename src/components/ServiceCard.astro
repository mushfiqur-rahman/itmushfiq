---
import { Icon } from "astro-icon/components";

export interface Props {
  title: string;
  desc: string;
  href: string;
  icon: string;
}

const { title, desc, href, icon } = Astro.props;
---

<a
  href={href}
  class="group relative flex flex-col p-8 rounded-2xl bg-white/60 dark:bg-white/5 backdrop-blur-xl border-2 border-slate-200 dark:border-white/10 hover:border-[#2D058A] dark:hover:border-[#90ee02]/50 hover:bg-white dark:hover:bg-white/10 transition-all duration-500 overflow-hidden z-10 hover:shadow-[8px_8px_0px_0px_rgba(45,5,138,0.1)] dark:hover:shadow-none"
>
  <div
    class="absolute -top-16 -right-16 w-40 h-40 bg-[#2D058A]/10 dark:bg-[#90ee02]/20 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
  >
  </div>

  <div
    class="w-14 h-14 rounded-xl bg-[#2D058A] dark:bg-linear-to-br dark:from-[#2D058A] dark:to-[#150734] border border-[#2D058A] dark:border-white/10 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:shadow-[0_0_20px_rgba(45,5,138,0.3)] dark:group-hover:shadow-[0_0_20px_rgba(144,238,2,0.3)] transition-all duration-300"
  >
    <Icon name={icon} class="w-7 h-7 text-[#90ee02]" />
  </div>

  <h3
    class="text-2xl font-black text-[#2D058A] dark:text-white mb-3 tracking-tight group-hover:text-[#2D058A] dark:group-hover:text-[#90ee02] transition-colors"
  >
    {title}
  </h3>
  <p
    class="text-slate-600 dark:text-slate-400 font-medium text-sm leading-relaxed mb-8 grow"
  >
    {desc}
  </p>

  <div
    class="flex items-center text-xs font-black text-[#2D058A] dark:text-white group-hover:text-[#2D058A] dark:group-hover:text-[#90ee02] transition-colors mt-auto uppercase tracking-widest"
  >
    Explore Service
    <Icon
      name="lucide:arrow-right"
      class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform duration-300"
    />
  </div>
</a>
