---
const experiences = [
  {
    title: "IT Support Engineer",
    company: "Upwork",
    location: "Jashore, Bangladesh",
    date: "Jan '25 - Present",
    type: "Freelance",
    description: "Providing remote IT support specializing in M365 and Google Workspace infrastructure.",
    skills: ["M365", "Google Workspace", "Technical Support"]
  },
  {
    title: "IT Support Engineer",
    company: "Innovative Software",
    location: "Khulna, Bangladesh",
    date: "Mar '23 - Jan '25",
    type: "Full-Time",
    description: "Managed Google Play console, app publications, SQLite3 databases, and website development/maintenance.",
    skills: ["Google Play Console", "SQLite3", "Web Maintenance"]
  },
  {
    title: "Python Django Developer",
    company: "DoWell Research",
    location: "United Kingdom",
    date: "Apr '22 - Mar '23",
    type: "Remote",
    description: "API development and implementation, team collaboration, troubleshooting, testing, and debugging software to improve efficiency.",
    skills: ["Python", "Django", "API Development", "Debugging"]
  },
  {
    title: "Software Engineer Trainee",
    company: "Microdream IT",
    location: "Jashore, Bangladesh",
    date: "Jan '21 - Dec '22",
    type: "Trainee",
    description: "Focused on SaaS application development and foundational software engineering practices.",
    skills: ["SaaS Development", "Software Engineering"]
  },
  {
    title: "Network Infrastructure Engineer",
    company: "Aamra Networks",
    location: "Dhaka, Bangladesh",
    date: "Feb '20 - Dec '21",
    type: "Full-Time",
    description: "Maintained and configured network infrastructure for enterprise clients.",
    skills: ["Networking", "Infrastructure", "Hardware"]
  },
  {
    title: "Customer Service Executive",
    company: "Chaldal",
    location: "Jashore, Bangladesh",
    date: "Apr '19 - Feb '20",
    type: "Full-Time",
    description: "Handled customer inquiries and ensured smooth operational support.",
    skills: ["Customer Support", "Communication"]
  }
];
---

<section class="py-24 bg-slate-50 dark:bg-[#0f0224] overflow-hidden w-full">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <header class="mb-24 text-center">
      <h2 class="text-4xl md:text-5xl font-black text-[#2D058A] dark:text-white tracking-tighter mb-4">
        Career <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#2D058A] to-[#7b2cbf] dark:from-[#90ee02] dark:to-[#ccff66]">Journey</span>
      </h2>
      <p class="text-lg font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">
        A timeline of my professional experience
      </p>
    </header>

    <!-- Timeline Wrapper -->
    <div class="relative w-full">
      
      <!-- Central Line (Strict positioning that won't distort grid spacing) -->
      <div class="absolute top-0 bottom-0 left-4 md:left-1/2 w-1 bg-[#2D058A] dark:bg-[#90ee02] transform md:-translate-x-1/2 rounded-full hidden sm:block"></div>

      <div class="space-y-16">
        {experiences.map((exp, index) => {
          const isLeft = index % 2 === 0;
          
          return (
            <div class="relative flex flex-col md:flex-row items-center w-full justify-between">
              
              <!-- Timeline Central Icon dot -->
              <div class="absolute left-4 md:left-1/2 transform -translate-x-1/2 z-10 hidden sm:flex items-center justify-center w-10 h-10 rounded-full bg-[#90ee02] border-4 border-[#2D058A] shadow-[2px_2px_0px_0px_rgba(45,5,138,1)] dark:shadow-[2px_2px_0px_0px_rgba(144,238,2,0.3)]">
                <svg class="w-4 h-4 text-[#2D058A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>

              <!-- Main Card block with flex alternating placement -->
              <div class={`w-full md:w-[45%] pl-10 sm:pl-12 md:pl-0 ${isLeft ? 'md:mr-auto' : 'md:ml-auto'}`}>
                <div class="bg-white dark:bg-[#150734] border-4 border-[#2D058A] dark:border-white/10 rounded-2xl p-6 md:p-8 shadow-[8px_8px_0px_0px_rgba(45,5,138,1)] dark:shadow-[8px_8px_0px_0px_rgba(144,238,2,0.3)] hover:-translate-y-1 hover:shadow-[12px_12px_0px_0px_rgba(45,5,138,1)] dark:hover:shadow-[12px_12px_0px_0px_rgba(144,238,2,0.5)] transition-all duration-300 relative">
                  
                  <!-- Date and Badge (Responsive Stack) -->
                  <div class="flex flex-wrap items-center gap-3 mb-4">
                    <span class="inline-block px-3 py-1 bg-[#90ee02] text-[#2D058A] font-black uppercase tracking-widest text-[10px] sm:text-xs border-2 border-[#2D058A] rounded-full shadow-[2px_2px_0px_0px_rgba(45,5,138,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] shrink-0">
                      {exp.type}
                    </span>
                    <span class="text-xs sm:text-sm font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">
                      {exp.date}
                    </span>
                  </div>

                  <!-- Content Block -->
                  <h3 class="text-xl sm:text-2xl font-black text-[#2D058A] dark:text-white mb-1 leading-tight">
                    {exp.title}
                  </h3>
                  <h4 class="text-base sm:text-lg font-bold text-slate-700 dark:text-[#90ee02] mb-4 flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span>{exp.company}</span>
                    <span class="text-slate-400 dark:text-slate-500 text-xs sm:text-sm font-medium">📍 {exp.location}</span>
                  </h4>

                  <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 font-medium mb-6 leading-relaxed">
                    {exp.description}
                  </p>

                  <!-- Skills Section (Strict Wrap block) -->
                  <div class="flex flex-wrap gap-2">
                    {exp.skills.map((skill) => (
                      <span class="px-2.5 py-1 bg-slate-100 dark:bg-[#0f0224] text-slate-700 dark:text-white text-[10px] sm:text-xs font-bold uppercase tracking-wider border-2 border-slate-300 dark:border-white/20 rounded-lg">
                        {skill}
                      </span>
                    ))}
                  </div>

                </div>
              </div>

            </div>
          );
        })}
      </div>

    </div>
  </div>
</section>