---
import BaseLayout from './BaseLayout.astro';
import { bookingUrl } from '../data/booking';
// Shared listing shell follows the homepage hero's navy, cyan, violet and lime.
// Page files supply only content; no duplicated navigation tabs are needed.
interface Props { title: string; description: string; eyebrow: string; heading: string; accent: string }
const { title, description, eyebrow, heading, accent } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="proof-page relative isolate overflow-hidden pb-24 pt-32 sm:pt-40">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[.16em] text-[#c4ff69]">{eyebrow}</p>
        <h1 class="mt-6 text-5xl font-semibold leading-[1.05] tracking-[-.055em] text-white sm:text-6xl lg:text-7xl">{heading} <span class="bg-gradient-to-r from-cyan-200 via-white to-[#a3ff12] bg-clip-text text-transparent">{accent}</span></h1>
        <p class="mt-7 text-lg leading-8 text-slate-300">{description}</p>
      </header>
      <div class="mt-14"><slot /></div>
      <aside class="site-surface mt-20 flex flex-col items-start justify-between gap-6 rounded-3xl p-8 sm:p-10 md:flex-row md:items-center">
        <div><p class="text-xs font-bold uppercase tracking-[.16em] text-[#a3ff12]">Your next chapter</p><h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">Let's get your systems working for you.</h2><p class="mt-3 text-slate-300">Tell me what your team needs. We'll work out the next step.</p></div>
        <a href={bookingUrl} class="shrink-0 rounded-xl bg-[#a3ff12] px-6 py-3.5 text-sm font-bold text-[#071225] transition hover:bg-[#c4ff69]">Book a consultation <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </div>
</BaseLayout>
<style>
  .proof-page{background:radial-gradient(ellipse at 0 0,#22d3ee20,transparent 35%),radial-gradient(ellipse at 100% 5%,#8b5cf633,transparent 35%),linear-gradient(#94a3b807 1px,transparent 1px),linear-gradient(90deg,#94a3b807 1px,transparent 1px),#071225;background-size:auto,auto,64px 64px,64px 64px,auto}
</style>
