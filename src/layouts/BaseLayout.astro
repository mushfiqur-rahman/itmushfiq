---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/Schema.astro";

import "@fontsource/poppins/400.css"; // Regular
import "@fontsource/poppins/500.css"; // Medium
import "@fontsource/poppins/700.css"; // Bold
import "@fontsource/poppins/900.css"; // Black

const {
  title,
  description,
  image,
  articleDate,
  type = "WebSite",
} = Astro.props;
const currentUrl = Astro.url.href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Expert Remote IT Support, Microsoft 365, Google Workspace, and Custom Web Development Services."
    />
    <title>{title}</title>

    <Schema
      title={title}
      description={description ||
        "IT Support Bee - Remote IT Infrastructure Management"}
      url={currentUrl}
      type={type}
      image={image}
      pubDate={articleDate}
    />

    <script is:inline>
      // HTML রেন্ডার হওয়ার আগেই থিম অ্যাপ্লাই করে দেবে
      const theme = localStorage.getItem("theme");
      if (
        theme === "dark" ||
        (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>

    <!-- ========================================== -->
    <!-- SEO & VERIFICATION META TAGS               -->
    <!-- ========================================== -->
    <meta name="msvalidate.01" content="967D05F8C7F9343E1A1F222CA5615E13" />
    <meta name="p:domain_verify" content="55bd5cb7350e20b1349e6cef4d2d52c6" />
    <meta name="yandex-verification" content="3f14f1973fc27b8c" />
    <meta property="fb:app_id" content="1455261176418413" />

    <!-- ========================================== -->
    <!-- ANALYTICS & TRACKING SCRIPTS               -->
    <!-- ========================================== -->

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-GSM0ML8M7W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-GSM0ML8M7W");
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "ybsakmhdqk");
    </script>

    <!-- Ahrefs Analytics -->
    <script
      is:inline
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="4+tklWCKIgo4KH14uNvO6w"
      async></script>
  </head>
  <body
    class="bg-slate-50 dark:bg-[#0f0224] text-slate-800 dark:text-slate-200 transition-colors duration-300"
  >
    <Header />
    <main class="grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
