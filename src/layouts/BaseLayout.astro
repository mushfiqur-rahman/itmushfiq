---
import "../styles/global.css";
import Header from "../components/HeaderRedesign.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/Schema.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

import "@fontsource/poppins/400.css"; // Regular
import "@fontsource/poppins/500.css"; // Medium
import "@fontsource/poppins/700.css"; // Bold
import "@fontsource/poppins/900.css"; // Black

const {
  title,
  description = "Business email migration, deliverability troubleshooting, Microsoft 365 and Google Workspace management, and remote IT support from IT Support Bee.",
  image,
  articleDate,
  type = "WebSite",
  includeSchema = true,
} = Astro.props;
const currentUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description}
    />
    <title>{title}</title>
    <link rel="canonical" href={currentUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="IT Support Bee service guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content={type === "Article" ? "article" : "website"} />
    <meta property="og:site_name" content="IT Support Bee" />
    {image && <meta property="og:image" content={new URL(image, currentUrl).href} />}

    {includeSchema && <Schema
      title={title}
      description={description ||
        "IT Support Bee - Remote IT Support for Business"}
      url={currentUrl}
      type={type}
      image={image}
      pubDate={articleDate}
    />}
    <slot name="head" />
  </head>
  <body class="bg-[#0f0224] text-slate-200">
    <Header />
    <main id="main-content" tabindex="-1" class="grow">
      <slot />
      <WhatsAppButton />
    </main>
    <Footer />

    <!-- ========================================== -->
    <!-- SEO & VERIFICATION META TAGS               -->
    <!-- ========================================== -->
    <meta name="msvalidate.01" content="967D05F8C7F9343E1A1F222CA5615E13" />
    <meta name="p:domain_verify" content="55bd5cb7350e20b1349e6cef4d2d52c6" />
    <meta name="yandex-verification" content="3f14f1973fc27b8c" />
    <meta property="fb:app_id" content="1455261176418413" />

    <!-- ========================================== -->
    <!-- ANALYTICS & TRACKING SCRIPTS               -->
    <!-- ========================================== -->

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-GSM0ML8M7W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-GSM0ML8M7W");
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "ybsakmhdqk");
    </script>

    <!-- Ahrefs Analytics -->
    <script
      is:inline
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="4+tklWCKIgo4KH14uNvO6w"
      async></script>
  </body>
</html>
