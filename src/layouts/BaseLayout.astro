---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/Schema.astro";

import "@fontsource/poppins/400.css"; // Regular
import "@fontsource/poppins/500.css"; // Medium
import "@fontsource/poppins/700.css"; // Bold
import "@fontsource/poppins/900.css"; // Black

const {
  title,
  description,
  image,
  articleDate,
  type = "WebSite",
} = Astro.props;
const currentUrl = Astro.url.href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Expert Remote IT Support, Microsoft 365, Google Workspace, and Custom Web Development Services."
    />
    <title>{title}</title>

    <Schema
      title={title}
      description={description ||
        "IT Support Bee - Remote IT Infrastructure Management"}
      url={currentUrl}
      type={type}
      image={image}
      pubDate={articleDate}
    />

    <script is:inline>
      // HTML রেন্ডার হওয়ার আগেই থিম অ্যাপ্লাই করে দেবে
      const theme = localStorage.getItem("theme");
      if (
        theme === "dark" ||
        (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body
    class="bg-slate-50 text-slate-900 font-['Poppins'] antialiased selection:bg-indigo-100 selection:text-indigo-900 flex flex-col min-h-screen"
  >
    <Header />
    <main class="grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
